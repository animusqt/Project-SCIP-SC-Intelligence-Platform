<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/twin"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             x:Class="ScipDashboard.Modules.Fleet.FleetModuleView"
              >
    <UserControl.Resources>
        <Style x:Key="ShipCard" TargetType="Border">
            <Setter Property="Background" Value="#2c3e50"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20">
            <TextBlock Text="Fleet Directory" FontSize="24" FontWeight="Bold" Foreground="#FFC107"/>
            <TextBox   Width="300" Margin="20,0,0,0" HorizontalAlignment="Left" 
                     x:Name="SearchBox"
                     Tag="Search ships..." VerticalAlignment="Center" Padding="5"
                     TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <WrapPanel Orientation="Horizontal">
                <ItemsControl   ItemsSource="{Binding FilteredShips}"/>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>