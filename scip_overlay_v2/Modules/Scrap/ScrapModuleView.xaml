<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/twin"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             x:Class="ScipDashboard.Modules.Scrap.ScrapModuleView"
              >
    <UserControl.Resources>
        <Style x:Key="ScrapItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20">
            <TextBlock Text="Scrap Management" FontSize="24" FontWeight="Bold" Foreground="#FFC107"/>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Scrap Inventory List -->
            <GroupBox Header="Scrap Inventory" Grid.Column="0">
                <ListBox   x:Name="ScrapListBox" ItemsSource="{Binding ScrapItems}" DisplayMemberPath="Name" 
                         SelectionChanged="ScrapListBox_SelectionChanged"/>
            </GroupBox>

            <!-- Scrap Details / Actions -->
            <GroupBox Header="Scrap Details" Grid.Column="1" Margin="10,0,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Select a scrap item to view details" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <TextBlock Text="Details:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock   Text="Name" FontSize="18" Margin="0,0,0,10"/>
                    <TextBlock   Text="Type" Margin="0,0,0,10"/>
                    <TextBlock   Text="Quantity" Margin="0,0,0,10"/>
                    <Button Content="Process Scrap" Margin="0,20,0,0" Padding="10,5" Background="#FFC107" Foreground="Black"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>