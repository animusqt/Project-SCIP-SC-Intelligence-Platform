<UserControl x:Class="ScipDashboard.WPF.Modules.SalvageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression.blend/2008"
             xmlns:vm="clr-namespace:ScipDashboard.WPF.ViewModels"
             xmlns:converters="clr-namespace:ScipDashboard.WPF.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:SalvageViewModel}">

    <UserControl.Resources>
        <converters:DataSourceStatusToTextConverter x:Key="StatusToText"/>
        <converters:MarginToColorConverter x:Key="MarginToColor"/>
        <converters:RiskToColorConverter x:Key="RiskToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style TargetType="Border" x:Key="StatCardStyle">
            <Setter Property="Background" Value="{DynamicResource GradientCard}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,16,16,0">

            <!-- ==================== HEADER ==================== -->
            <Border Margin="0,0,0,20" Background="{DynamicResource GradientCard}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="10"
                                Margin="0,0,12,0">
                            <TextBlock Text="🗑️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Salvaging" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                            <TextBlock Text="Salvage locations, material yields, and profit estimates" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="12" Padding="8,4">
                        <TextBlock Text="{Binding DataStatus, Converter={StaticResource StatusToText}}" FontSize="10" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <Border Margin="0,0,0,12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Padding="8,4" Margin="0,0,8,0"
                             Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource PrimaryTextColor}"
                             ToolTip="Search salvage locations by name"/>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding LocationNames}"
                              SelectedItem="{Binding SelectedLocation}"
                              Width="130" FontSize="11" Margin="0,0,8,0"
                              Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                              Foreground="{DynamicResource PrimaryTextColor}"
                              ToolTip="Filter by location"/>

                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ==================== SALVAGE LOCATIONS TABLE ==================== -->
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="8,6"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Location" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="0"/>
                            <TextBlock Text="System" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="1"/>
                            <TextBlock Text="Items" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="2" HorizontalAlignment="Center"/>
                            <TextBlock Text="Yield (SCU)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="3" HorizontalAlignment="Right"/>
                            <TextBlock Text="Demand (SCU)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="4" HorizontalAlignment="Right"/>
                            <TextBlock Text="Avg Profit" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="5" HorizontalAlignment="Right"/>
                            <TextBlock Text="Risk" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="6" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Location List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Locations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                            Background="{DynamicResource CardBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="160"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding LocationName}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextColor}" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SystemName}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"
                                                       Grid.Column="1" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SalvageItems}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"
                                                       Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding YieldText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessGreen}" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DemandText}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"
                                                       Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ProfitText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding AverageProfitPercent, Converter={StaticResource MarginToColor}}"
                                                       Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RiskText}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding Risk, Converter={StaticResource RiskToColor}}"
                                                       Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Empty State -->
            <Border Margin="0,20,0,20" Background="{DynamicResource CardBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="40"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🗑️" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="No salvage locations found" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try adjusting your filters or refreshing the data" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextColor}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
