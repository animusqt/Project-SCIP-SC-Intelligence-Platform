<UserControl x:Class="ScipDashboard.WPF.Modules.MarketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
             xmlns:local="clr-namespace:ScipDashboard.WPF.Modules"
             xmlns:viewmodels="clr-namespace:ScipDashboard.WPF.ViewModels"
             xmlns:converters="clr-namespace:ScipDashboard.WPF.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=viewmodels:MarketViewModel}">

    <UserControl.Resources>
        <converters:DataSourceStatusToTextConverter x:Key="StatusToText"/>
        <converters:DataSourceStatusToColorConverter x:Key="StatusToColor"/>
        <converters:MarginToColorConverter x:Key="MarginToColor"/>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>
        <converters:DateTimeToFriendlyStringConverter x:Key="DateTimeToFriendly"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,16,16,0">

            <!-- ==================== HEADER ==================== -->
            <Border Margin="0,0,0,16" Background="{DynamicResource CardBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="8"
                                Margin="0,0,12,0">
                            <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Market Overview" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                            <TextBlock Text="live · 15s refresh" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1">
                        <Border Background="{Binding StatusColor}" CornerRadius="12" Padding="8,4" Margin="0,0,12,0">
                            <TextBlock Text="{Binding DataStatus, Converter={StaticResource StatusToText}}" FontSize="10" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="8,4">
                            <TextBlock Text="{Binding LastUpdated, Converter={StaticResource DateTimeToFriendly}, StringFormat='{}{0} UTC'}"
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== QUICK STATS ==================== -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Best Gain -->
                <Border Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Best Gain (Risk-Adjusted)" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding BestGainName}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BestGainMargin}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessGreen}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BestGainVolume}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,4,0"/>
                            <TextBlock Text="vol" FontSize="9" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BestGainRisk}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Biggest Loss -->
                <Border Grid.Column="1" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Biggest Loss (Risk-Adjusted)" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding BiggestLossName}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BiggestLossMargin}" FontSize="13" FontWeight="Bold"
                                   Foreground="#EF4444" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BiggestLossVolume}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,4,0"/>
                            <TextBlock Text="vol" FontSize="9" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BiggestLossRisk}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Most Traded -->
                <Border Grid.Column="2" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Most Traded" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding MostTradedName}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MostTradedMargin}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MostTradedVolume}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,4,0"/>
                            <TextBlock Text="vol" FontSize="9" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding MostTradedRisk}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== FILTER BAR ==================== -->
            <Border Margin="0,0,0,12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16">
                <Grid Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category Chips -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}" Margin="0,0,12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" FontSize="10" Padding="8,4" Margin="0,0,6,0"
                                        Foreground="{DynamicResource PrimaryTextColor}"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.FilterByCategoryCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Filter by category">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
                                                    <Setter Property="Foreground" Value="#020817"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sort Dropdown -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortBy}"
                              Width="110" FontSize="10" Margin="0,0,8,0"
                              Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                              Foreground="{DynamicResource PrimaryTextColor}"/>

                    <!-- Sort Direction -->
                    <Button Grid.Column="2" FontSize="12" Padding="6,4" Margin="0,0,8,0"
                            Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource PrimaryTextColor}"
                            Command="{Binding ToggleSortCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▼"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SortDescending}" Value="True">
                                        <Setter Property="Content" Value="▲"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Favourites -->
                    <Button Grid.Column="3" FontSize="10" Padding="8,4" Margin="0,0,8,0"
                            Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource PrimaryTextColor}"
                            Command="{Binding ToggleFavoritesFilterCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="☆ Favourites"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavoritesOnly}" Value="True">
                                        <Setter Property="Content" Value="★ Favourites"/>
                                        <Setter Property="Foreground" Value="#F5B32F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Grid Grid.Column="4" Width="1"/>

                    <!-- Actions -->
                    <Button Grid.Column="5" Content="🔄 Refresh" FontSize="10" Width="70" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVisibility}}"
                            Background="{DynamicResource PrimaryOrangeBrush}" Foreground="{DynamicResource PrimaryTextColor}"
                            BorderThickness="0"/>

                    <Button Grid.Column="6" Content="Clear" FontSize="10" Width="60"
                            Command="{Binding ClearFiltersCommand}"
                            Foreground="{DynamicResource PrimaryTextColor}"
                            Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                </Grid>
            </Border>

            <!-- ==================== KIOSK SCANNER ==================== -->
            <Border Margin="0,0,0,12" Background="{DynamicResource CardBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Kiosk Scanner" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,10"/>
                    <TextBlock Text="Photograph a commodity terminal and drop the shot here. The reader pulls prices and stock, and the board trusts your numbers over the crowd feed for the next few hours."
                               FontSize="10" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Padding="12" Height="80">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📤" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Upload screenshot" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                                <TextBlock Text="Drag a PNG/JPEG here, or click and press Ctrl+V to paste" FontSize="9"
                                           Foreground="{DynamicResource SecondaryTextColor}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Import Local Scan (.json)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                                <TextBlock Text="Run the SC Price Scanner app in-game (F9), then drag the JSON here." FontSize="9"
                                           Foreground="{DynamicResource SecondaryTextColor}" Margin="0,2,0,0"/>
                                <TextBlock Text="Get it at /tools" FontSize="9" Foreground="{DynamicResource PrimaryOrangeBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== STATUS MESSAGE ==================== -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}"
                    Margin="0,0,0,8" Background="{DynamicResource CardBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="12,8">
                <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- ==================== LOADING INDICATOR ==================== -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,0,12" Background="{DynamicResource CardBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🌀" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Loading market data..." FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ==================== COMMODITY TABLE ==================== -->
            <Border Margin="0,0,0,12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="8,6"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="★" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Commodity" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="1"/>
                            <TextBlock Text="Category" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="2"/>
                            <TextBlock Text="Buy" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" Grid.Column="3" HorizontalAlignment="Right"/>
                            <TextBlock Text="Sell" FontSize="10" FontWeight="Bold" Foreground="#EF4444" Grid.Column="4" HorizontalAlignment="Right"/>
                            <TextBlock Text="Margin" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryOrangeBrush}" Grid.Column="5" HorizontalAlignment="Right"/>
                            <TextBlock Text="Volume" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="6" HorizontalAlignment="Right"/>
                            <TextBlock Text="Supply / Demand" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="7" HorizontalAlignment="Center"/>
                            <TextBlock Text="Risk" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Last Change" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="9" HorizontalAlignment="Right"/>
                            <TextBlock Text="Best Buy → Sell" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="10"/>
                            <TextBlock Text="Trend" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Commodity List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Commodities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Main Row -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*" MinWidth="180"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Favourite Star -->
                                                <Button Grid.Column="0" Content="☆" FontSize="10" Padding="0" Margin="0" BorderThickness="0" Background="Transparent"
                                                        Foreground="#94A3B8"
                                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.ToggleWatchlistCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnWatchlist}" Value="True">
                                                                    <Setter Property="Content" Value="★"/>
                                                                    <Setter Property="Foreground" Value="#F5B32F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Commodity Name -->
                                                <Button Grid.Column="1" Content="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextColor}"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"
                                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.ExpandRowCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        ToolTip="{Binding Name}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIllegal}" Value="True">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Category -->
                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"
                                                           Grid.Column="2" VerticalAlignment="Center"/>

                                                <!-- Buy Price -->
                                                <TextBlock Text="{Binding BuyPrice, StringFormat='{}{0:0}'}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource SuccessGreen}" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                <!-- Sell Price -->
                                                <TextBlock Text="{Binding SellPrice, StringFormat='{}{0:0}'}" FontSize="10" FontWeight="Bold"
                                                           Foreground="#EF4444" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                <!-- Margin -->
                                                <TextBlock Text="{Binding Margin, StringFormat='{}{0:0.##}%'}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding Margin, Converter={StaticResource MarginToColor}}" Grid.Column="5"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                <!-- Volume -->
                                                <TextBlock Text="{Binding Volume, StringFormat='{}{0:#,##0}'}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"
                                                           Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                <!-- Supply / Demand -->
                                                <TextBlock Text="{Binding SupplyDemandText}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"
                                                           Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Risk -->
                                                <TextBlock Text="{Binding RiskText}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding Risk, Converter={StaticResource RiskToColor}}"
                                                           Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Last Change -->
                                                <TextBlock Text="{Binding LastUpdated, StringFormat='{}{0:ss}s ago'}" FontSize="9"
                                                           Foreground="{DynamicResource SecondaryTextColor}" Grid.Column="9"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                <!-- Best Buy → Sell -->
                                                <TextBlock Text="{Binding BuyLocation}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"
                                                           Grid.Column="10" VerticalAlignment="Center" ToolTip="Best buy location"/>

                                                <!-- Trend -->
                                                <TextBlock Text="{Binding Trend}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding Trend, Converter={StaticResource TrendToColor}}"
                                                           Grid.Column="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Expanded Station Detail -->
                                            <Border Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                                    Background="{DynamicResource CardBrush}" CornerRadius="6" Margin="0,4,0,0"
                                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="12">
                                                <ItemsControl ItemsSource="{Binding StationObservations}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4"
                                                                    Margin="0,0,8,8" Padding="8,6" Width="220">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding LocationName}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding SystemName}" FontSize="9"
                                                                               Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,6"/>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="Buy" FontSize="8" Foreground="{DynamicResource MutedTextColor}"/>
                                                                            <TextBlock Text="{Binding BuyPrice, StringFormat='{}{0:0}'}" FontSize="10" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource SuccessGreen}"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="Sell" FontSize="8" Foreground="{DynamicResource MutedTextColor}"/>
                                                                            <TextBlock Text="{Binding SellPrice, StringFormat='{}{0:0}'}" FontSize="10" FontWeight="Bold"
                                                                                       Foreground="#EF4444"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding MarginText}" FontSize="9" FontWeight="Bold"
                                                                               Foreground="{Binding Margin, Converter={StaticResource MarginToColor}}" Margin="0,4,0,0"/>
                                                                    <TextBlock Text="{Binding SourceName}" FontSize="8" Foreground="{DynamicResource MutedTextColor}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Empty State -->
            <Border Margin="0,0,0,20" Background="{DynamicResource CardBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="40"
                    Visibility="{Binding HasCommodities, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="No commodities found" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try adjusting your filters or refreshing the data" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextColor}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
