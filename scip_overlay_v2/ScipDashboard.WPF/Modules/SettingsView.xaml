<UserControl x:Class="ScipDashboard.WPF.Modules.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression.blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Diagnostic: Verify view renders -->
            <TextBlock Text="SETTINGS ACTIVE" FontSize="16" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryTextColor}" 
                       Margin="0,0,0,20"/>
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="24">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="⚙️ Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Configure application preferences, data sources, and behavior" FontSize="12" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,0,0,16"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,16"/>

                    <!-- Theme Selection Section -->
                    <TextBlock Text="Appearance" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Theme" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <RadioButton Content="🌙 Dark Mode" IsChecked="{Binding IsDarkModeSelected, Mode=TwoWay}" FontSize="12" Margin="0,4,0,4"/>
                            <RadioButton Content="☀️ Light Mode" IsChecked="{Binding IsLightModeSelected, Mode=TwoWay}" FontSize="12" Margin="0,4,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Current theme: " FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Theme}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Data Update Settings -->
                    <TextBlock Text="Data Update" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Auto-refresh" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Refresh interval (minutes):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableIntervals}" SelectedItem="{Binding RefreshInterval, Mode=TwoWay}" FontSize="12" Width="100" HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryTextColor}"/>
                            <TextBlock Text="{Binding RefreshInterval, StringFormat='Refreshes every {0} minutes'}" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Notification Settings -->
                    <TextBlock Text="Notifications" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <CheckBox Content="Enable email notifications for route changes" IsChecked="{Binding EnableEmailNotifications, Mode=TwoWay}" FontSize="12" Margin="0,4,0,4"/>
                            <CheckBox Content="Enable desktop notifications" IsChecked="{Binding EnableDesktopNotifications, Mode=TwoWay}" FontSize="12" Margin="0,4,0,4"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Data Source Selection -->
                    <TextBlock Text="Primary Data Source" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <ComboBox ItemsSource="{Binding DataSources}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding DefaultDataSource, Mode=TwoWay}" FontSize="12" Margin="0,4,0,4" Foreground="{DynamicResource PrimaryTextColor}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Current source: " FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DefaultDataSource}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Route Preferences -->
                    <TextBlock Text="Route Preferences" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Default route strategy:" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Preferences}" DisplayMemberPath="Name" SelectedItem="{Binding DefaultPreference, Mode=TwoWay}" FontSize="12" Width="200" HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryTextColor}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <TextBlock Text="Applied when creating new hauling routes" FontSize="10" Foreground="{DynamicResource MutedTextColor}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Login / Session -->
                    <TextBlock Text="Account &amp; Session" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Login" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Username:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding LoginUsername, Mode=TwoWay}" FontSize="11" Padding="4,2" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextColor}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Password:" Grid.Column="0" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <PasswordBox Grid.Column="1" Password="{Binding LoginPassword, Mode=TwoWay}" FontSize="11" Padding="4,2" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextColor}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Login" Command="{Binding LoginCommand}" FontSize="11" Padding="10,4" Margin="0,0,8,0"
                                        Background="{DynamicResource PrimaryOrangeBrush}" BorderThickness="0"
                                        Foreground="{DynamicResource PrimaryTextColor}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                    <Setter Property="Content" Value="Logout"/>
                                                    <Setter Property="Command" Value="{Binding LogoutCommand}"/>
                                                    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding LoginDisplayText}" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LoginStatusMessage}" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Session token stored securely in app settings. Logout clears stored credentials." FontSize="9" Foreground="{DynamicResource MutedTextColor}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Star Citizen Server Preferences -->
                    <TextBlock Text="Star Citizen Servers" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Persistent Universe Server:" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableServers}" SelectedItem="{Binding PersistentUniverseServer, Mode=TwoWay}" FontSize="12" Width="100" HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryTextColor}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Arena Commander Server:" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableServers}" SelectedItem="{Binding ArenaCommanderServer, Mode=TwoWay}" FontSize="12" Width="100" HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryTextColor}"/>
                            </Grid>
                            <TextBlock Text="Select your preferred server region for each Star Citizen module." FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- System Information -->
                    <TextBlock Text="System Information" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Application Version: 2.0" FontSize="12" Margin="0,4,0,4"/>
                            <TextBlock Text="Last settings update:" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding LastSettingsUpdate}" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Border Margin="0,24,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset to Defaults" Command="{Binding ResetToDefaultsCommand}" FontSize="12" Padding="12,6" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                            <Button Content="Save Changes" Command="{Binding SaveSettingsCommand}" FontSize="12" Padding="12,6" Background="{DynamicResource PrimaryOrangeBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
