<Window x:Class="ScipDashboard.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScipDashboard.WPF"
        Title="SC Intelligence Platform - Dashboard"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#fafafa"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Color Definitions -->
            <Color x:Key="SafetyOrange">#FFC107</Color>
            <Color x:Key="DeepCharcoal">#2c3e50</Color>
            <Color x:Key="NavySidebar">#1a252f</Color>
            <Color x:Key="BackgroundGray">#fafafa</Color>
            <Color x:Key="CardBackground">#f5f5f5</Color>
            <Color x:Key="TextLight">#ecf0f1</Color>
            <Color x:Key="TextDark">#2c3e50</Color>
            
            <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="{StaticResource SafetyOrange}"/>
            <SolidColorBrush x:Key="CharcoalBrush" Color="{StaticResource DeepCharcoal}"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource NavySidebar}"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundGray}"/>
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBackground}"/>
            <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLight}"/>
            <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDark}"/>
            
            <!-- Button Style for Window Controls -->
            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFC107"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- Main Container -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Window Controls Row -->
        <Border Grid.Row="0" Background="{StaticResource CharcoalBrush}" Height="32">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Style="{StaticResource WindowControlButton}" Click="OnMinimizeClick">
                    <Path Data="M 4,4 L 8,0 L 12,4 Z" Fill="{StaticResource PrimaryOrangeBrush}"/>
                </Button>
                <Button Style="{StaticResource WindowControlButton}" Click="OnMaximizeClick">
                    <Path Data="M 6,6 L 12,18 L 18,6 Z" Fill="{StaticResource PrimaryOrangeBrush}"/>
                </Button>
                <Button Style="{StaticResource WindowControlButton}" Click="OnCloseClick">
                    <Path Data="M 3,3 L 5,5 L 15,5 L 9,11 L 21,9 Z" Fill="{StaticResource PrimaryOrangeBrush}"/>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" CornerRadius="0,0,8,8" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Padding="16,20,16,20" Background="{StaticResource CharcoalBrush}">
                        <TextBlock Text="SC Intelligence" Foreground="{StaticResource PrimaryOrangeBrush}" 
                                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- Navigation Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <!-- Dashboard -->
                            <Button Content="📊 Dashboard" Click="Navigate_Dashboard" 
                                    Style="{StaticResource SidebarButtonStyle}" 
                                    Tag="Dashboard"/>
                            
                            <!-- Market Overview -->
                            <Button Content="💰 Market Overview" Click="Navigate_Market" 
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Tag="Market"/>
                                    
                            <!-- Hauling -->
                            <Button Content="🚛 Hauling" Click="Navigate_Hauling" 
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Tag="Hauling"/>
                                    
                            <!-- Fleet -->
                            <Button Content="⛵ Fleet" Click="Navigate_Fleet" 
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Tag="Fleet"/>
                                    
                            <!-- StarQuester -->
                            <Button Content="⭐ StarQuester" Click="Navigate_StarQuester" 
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Tag="StarQuest"/>
                                    
                            <!-- Settings -->
                            <Button Content="⚙️ Settings" Click="Navigate_Settings" 
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Tag="Settings"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- User Section -->
                    <Border Grid.Row="2" Padding="16" Background="{StaticResource CharcoalBrush}" CornerRadius="8,8,0,0" Margin="8,0,8,8">
                        <StackPanel>
                            <Ellipse Width="40" Height="40" Fill="{StaticResource PrimaryOrangeBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="User" Foreground="{StaticResource TextLightBrush}" 
                                       HorizontalAlignment="Center" Margin="0,8,0,4" FontSize="14"/>
                            <TextBlock Text="Online" Foreground="#4caf50" 
                                       HorizontalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- ===== MAIN CONTENT AREA ===== -->
            <Grid Grid.Column="1" Margin="0,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- ===== STATS CARDS ROW ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Active Hauls Card -->
                    <Border Grid.Column="0" CornerRadius="8" Padding="16" Margin="0,0,10,0" 
                            Background="#e3f2fd" BorderBrush="#bbdefb" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Active Hauls" HorizontalAlignment="Center" 
                                       FontSize="12" Foreground="#1565c0" FontWeight="SemiBold"/>
                            <TextBlock Text="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="36" FontWeight="Bold" Foreground="#2c3e50" Margin="0,8,0,0"/>
                            <TextBlock Text="In Progress" HorizontalAlignment="Center" 
                                       FontSize="10" Foreground="#666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Available Routes Card -->
                    <Border Grid.Column="1" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                            Background="#e8f5e9" BorderBrush="#c8e6c9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Available Routes" HorizontalAlignment="Center"
                                       FontSize="12" Foreground="#2e7d32" FontWeight="SemiBold"/>
                            <TextBlock Text="0" HorizontalAlignment="Center" 
                                       FontSize="36" FontWeight="Bold" Foreground="#2c3e50" Margin="0,8,0,0"/>
                            <TextBlock Text="Planned" HorizontalAlignment="Center"
                                       FontSize="10" Foreground="#666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Fleet Available Card -->
                    <Border Grid.Column="2" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                            Background="#fff3e0" BorderBrush="#ffcc80" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Fleet Available" HorizontalAlignment="Center"
                                       FontSize="12" Foreground="#ef6c00" FontWeight="SemiBold"/>
                            <TextBlock Text="0/0" HorizontalAlignment="Center"
                                       FontSize="36" FontWeight="Bold" Foreground="#2c3e50" Margin="0,8,0,0"/>
                            <TextBlock Text="Ships Ready" HorizontalAlignment="Center"
                                       FontSize="10" Foreground="#666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Cargo Capacity Card -->
                    <Border Grid.Column="3" CornerRadius="8" Padding="16" Margin="0,0,0,0"
                            Background="#f3e5f5" BorderBrush="#ce93d8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Cargo Capacity" HorizontalAlignment="Center"
                                       FontSize="12" Foreground="#7b1fa2" FontWeight="SemiBold"/>
                            <TextBlock Text="0/0 SCU" HorizontalAlignment="Center"
                                       FontSize="36" FontWeight="Bold" Foreground="#2c3e50" Margin="0,8,0,0"/>
                            <TextBlock Text="Total Capacity" HorizontalAlignment="Center"
                                       FontSize="10" Foreground="#666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- ===== DYNAMIC CONTENT AREA ===== -->
                <Border Grid.Row="1" CornerRadius="8" Background="White" 
                        BorderBrush="#e0e0e0" BorderThickness="1" Padding="0">
                    <ContentControl Content="{Binding CurrentViewContent}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
