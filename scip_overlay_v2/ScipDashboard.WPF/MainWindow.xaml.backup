<!-- SCIP Dashboard - Main Window -->
<!-- Native C# WPF implementation (no Electron/Python) -->
<!-- Version: 1.0 - Clean rebuild for stability -->

<Window x:Class="ScipDashboard.Main.Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC Intelligence Platform - Dashboard" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#fafafa"
        ResizeMode="NoResize">

    <Grid Margin="16" Background="#fafafa">
        
        <!-- Top-right window controls -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,0">
            <Button Click="OnMinimizeClick" Width="24" Height="24">
                <Path Data="M 4,4 L 8,0 L 12,4 Z" Fill="#FFC107"/>
            </Button>
            <Button Click="OnMaximizeClick" Width="24" Height="24">
                <Path Data="M 6,6 L 12,18 L 18,6 Z" Fill="#FFC107"/>
            </Button>
            <Button Click="OnCloseClick" Width="24" Height="24">
                <Path Data="M 3,3 L 5,5 L 15,5 L 9,11 L 21,9 Z" Fill="#FFC107"/>
            </Button>
        </StackPanel>

                <!-- Main Dashboard Content (hidden initially) -->
                <Grid x:Name="MainPanel" Margin="0,0,0,0" Visibility="Hidden" Background="#fafafa">
                    
        <!-- Left Sidebar Navigation -->
                    <Border Width="240" Padding="16" VerticalAlignment="Stretch" HorizontalAlignment="Left">
                        <StackPanel>
                            <Border CornerRadius="8" Padding="16,12" Background="#3d3d3d">
                                <TextBlock Text="SC INTELLIGENCE PLATFORM" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Navigation Items -->
                            <Border CornerRadius="4" Padding="8,8" Background="Transparent" BorderBrush="#e0e0e0">
                                <MenuItem Header="OCR Scanner" Click="OnScanCommand_Click"/>
                            </Border>
                            <Border CornerRadius="4" Padding="8,8" Background="Transparent" BorderBrush="#e0e0e0">
                                <MenuItem Header="Market Lookup" Click="OnMarketCommand_Click"/>
                            </Border>
                            <Border CornerRadius="4" Padding="8,8" Background="Transparent" BorderBrush="#e0e0e0">
                                <MenuItem Header="Fleet Manager" Click="OnFleetCommand_Click"/>
                            </Border>
                            <Border CornerRadius="4" Padding="8,8" Background="Transparent" BorderBrush="#e0e0e0">
                                <MenuItem Header="Route Planner" Click="OnRouteCommand_Click"/>
                            </Border>

                            <!-- Settings -->
                            <Separator Margin="0,16,0,8"/>
                            
                            <Button Content="Settings" Click="OnSettingsClick"/>
                        </StackPanel>
                    </Border>

                    <!-- Main Content Area -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16,0,16,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <!-- Stats Row -->
                            <Border Grid.Row="0" Padding="24,16" Background="#f5f5f5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Active Hauls Card -->
                                    <Border Grid.Column="0" CornerRadius="8" Padding="16" Width="160" Height="120" Background="#e3f2fd">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Active Hauls" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Foreground="#1565c0"/>
                                            <TextBlock Text="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="36" FontWeight="Bold" Margin="12,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Available Routes Card -->
                                    <Border Grid.Column="1" CornerRadius="8" Padding="16" Width="160" Height="120" Background="#e8f5e9">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Available Routes" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Foreground="#2e7d32"/>
                                            <TextBlock Text="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="36" FontWeight="Bold" Margin="12,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Fleet Available Card -->
                                    <Border Grid.Column="2" CornerRadius="8" Padding="16" Width="160" Height="120" Background="#fff3e0">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Fleet Available" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Foreground="#ef6c00"/>
                                            <TextBlock Text="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="36" FontWeight="Bold" Margin="12,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cargo Capacity Card -->
                                    <Border Grid.Column="3" CornerRadius="8" Padding="16" Width="160" Height="120" Background="#f3e5f5">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Cargo Capacity" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Foreground="#7b1fa2"/>
                                            <TextBlock Text="0/0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="36" FontWeight="Bold" Margin="12,0"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Border>

                            <!-- Content Placeholder -->
                            <Grid Grid.Row="1">
                                <TextBlock Text="Dashboard ready - Select a module from the sidebar to start!" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Features available: OCR Scanner, Market Lookup, Fleet Management, Route Planning" FontSize="14"/>
                            </Grid>

                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Border>
    </StackPanel>
</Window>
