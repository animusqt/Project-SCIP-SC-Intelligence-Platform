<!-- SCIP Dashboard - Main Window -->
<!-- Native C# WPF implementation (no Electron/Python) -->

<Window x:Class="ScipDashboard.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScipDashboard.WPF"
        xmlns:vm="clr-namespace:ScipDashboard.WPF"
        Title="SC Intelligence Platform - Dashboard" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize"
        AllowsTransparency="False">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

<Grid Margin="16" Background="{DynamicResource GradientBackground}">
        
        <!-- Top-right window controls -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,0">
            <Button Click="OnMinimizeClick" Width="24" Height="24" Style="{StaticResource WindowControlButton}">
                <Path Data="M 4,4 L 8,0 L 12,4 Z" Fill="{DynamicResource PrimaryOrangeBrush}"/>
            </Button>
            <Button Click="OnMaximizeClick" Width="24" Height="24" Style="{StaticResource WindowControlButton}">
                <Path Data="M 6,6 L 12,18 L 18,6 Z" Fill="{DynamicResource PrimaryOrangeBrush}"/>
            </Button>
            <Button Click="OnCloseClick" Width="24" Height="24" Style="{StaticResource WindowControlButton}">
                <Path Data="M 3,3 L 5,5 L 15,5 L 9,11 L 21,9 Z" Fill="{DynamicResource PrimaryOrangeBrush}"/>
            </Button>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource GradientCard}" CornerRadius="8" Margin="0,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Margin="10">
                    <TextBlock Text="SC Intelligence" Foreground="{DynamicResource DarkModeTextBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <Button Content="Main Kiosk" Click="Navigate_Dashboard" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="Market Overview" Click="Navigate_Market" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="Hauling" Click="Navigate_Hauling" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="OCR | SCAN" Click="Navigate_OcrScan" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="Fleet" Click="Navigate_Fleet" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="StarQuester" Click="Navigate_StarQuester" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="Salvaging | Mining" Click="Navigate_Salvaging" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="Settings" Click="Navigate_Settings" Style="{StaticResource SidebarButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="20,0,0,0" Background="{DynamicResource GradientCard}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Dynamic Content Area -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewContent}"/>

                <!-- System Status - Bottom Center -->
                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="8,4" Margin="0,20,0,0" HorizontalAlignment="Center" MaxWidth="800" Height="30">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="System Status:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Connection" FontSize="10" Foreground="{DynamicResource CharcoalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" Online " FontSize="10" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Data Source" FontSize="10" Foreground="{DynamicResource CharcoalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" uexcorp.space " FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Last Sync" FontSize="10" Foreground="{DynamicResource CharcoalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" Never " FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Storage" FontSize="10" Foreground="{DynamicResource CharcoalBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" Local" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!-- Loading Screen Overlay -->
        <Border x:Name="LoadingOverlay" Background="#0a0a12" Opacity="0.98" Visibility="Visible">
            <Grid Margin="60">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Logo / Title -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                    <Border Width="60" Height="60" Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SC Intelligence Platform" 
                               Foreground="White" FontSize="28" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
                
                <!-- Status Text -->
                <TextBlock x:Name="StatusText" Grid.Row="1" Text="Initializing systems..." 
                           Foreground="#e0e0e0" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,32"/>
                
                <!-- Progress Bar Container -->
                <Border Grid.Row="2" Width="400" Height="8" 
                        Background="#2a2a3a" CornerRadius="4" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="LoadingBarFill" Width="0" Height="8" 
                            Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="4"
                            HorizontalAlignment="Left"/>
                </Border>
                
                <!-- Progress Percentage -->
                <TextBlock Grid.Row="3" x:Name="LoadingProgressText" Text="0%" 
                           Foreground="{DynamicResource PrimaryOrangeBrush}" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,0"/>
            </Grid>
        </Border>

    </Grid>
</Window>
