<Window x:Class="ScipDashboard.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCIP Dashboard"
        Width="520" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        ShowActivated="True">

    <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource PrimaryOrangeBrush}" BorderThickness="1" Margin="10">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Branding -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="SC Intelligence Platform" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryOrangeBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="SCIP Dashboard" FontSize="14" Foreground="{DynamicResource DarkModeTextBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.8"/>
            </StackPanel>

            <!-- Status text -->
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Initializing systems..."
                       Foreground="{DynamicResource DarkModeTextBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <!-- Indeterminate progress bar -->
            <ProgressBar Grid.Row="2" Height="6" IsIndeterminate="True"
                         Foreground="{DynamicResource PrimaryOrangeBrush}" Background="{DynamicResource DarkModeBorderBrush}" BorderThickness="0"/>

            <!-- Version -->
            <TextBlock Grid.Row="3" Text="Version 1.0.0" Foreground="{DynamicResource DarkModeSubtextBrush}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>
