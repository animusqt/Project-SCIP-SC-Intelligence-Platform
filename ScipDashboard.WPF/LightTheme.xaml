<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LIGHT MODE - SC-Truckers HUD Design System -->
    <!-- Deep-navy HUD theme with amber accent -->
    <!-- Background Colors -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#f9fbff"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#e7edf6"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#f4f7fa"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextColor" Color="#070b12"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#0d1520"/>
    <SolidColorBrush x:Key="MutedTextColor" Color="#4a5568"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentAmber" Color="#f5b32f"/>
    <SolidColorBrush x:Key="SecondaryAccentCyan" Color="#3ba8ff"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="#22c55e"/>
    <SolidColorBrush x:Key="WarningGold" Color="#d97706"/>

    <!-- Alias brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#f9fbff"/>
    <SolidColorBrush x:Key="CardBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#dbe4ee"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="CharcoalBrush" Color="#070b12"/>
    <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="#f5b32f"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#f5b32f"/>
    <SolidColorBrush x:Key="DarkModeTextBrush" Color="#070b12"/>
    <SolidColorBrush x:Key="DarkModeSubtextBrush" Color="#4a5568"/>
    <SolidColorBrush x:Key="DarkModeBorderBrush" Color="#dbe4ee"/>
    <SolidColorBrush x:Key="LightModeTextBrush" Color="#070b12"/>
    <SolidColorBrush x:Key="LightModeSubtextBrush" Color="#4a5568"/>
    <SolidColorBrush x:Key="LightModeBorderBrush" Color="#dbe4ee"/>

    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="SafetyOrange">#f5b32f</SolidColorBrush>
    <SolidColorBrush x:Key="DeepCharcoal">#070b12</SolidColorBrush>
    <SolidColorBrush x:Key="NavySidebar">#ffffff</SolidColorBrush>
    <SolidColorBrush x:Key="BackgroundGray">#f4f7fa</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackground">#ffffff</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryBackground">#e7edf6</SolidColorBrush>
    <SolidColorBrush x:Key="BorderColor">#dbe4ee</SolidColorBrush>
    <SolidColorBrush x:Key="OrangeColor">#f5b32f</SolidColorBrush>

    <!-- Gradient Brushes (Light Mode - bottom-left to top-right) -->
    <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#f9fbff" Offset="0"/>
        <GradientStop Color="#e7edf6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientCard" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#f4f7fa" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientHeader" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#3ba8ff" Offset="0"/>
        <GradientStop Color="#6b9ff0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientButton" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#f5b32f" Offset="0"/>
        <GradientStop Color="#d97706" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientPanel" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#eef3f9" Offset="1"/>
    </LinearGradientBrush>

    <!-- HUD Panel Style (gradient card with subtle border) -->
    <Style TargetType="Border" x:Key="HudPanelStyle">
        <Setter Property="Background" Value="{DynamicResource GradientPanel}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Window Control Button -->
    <Style TargetType="Button" x:Key="WindowControlButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Button -->
    <Style TargetType="Button" x:Key="SidebarButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card Style -->
    <Style TargetType="Border" x:Key="CardStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Accent Button -->
    <Style TargetType="Button" x:Key="OrangeButtonStyle">
        <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
        <Setter Property="Foreground" Value="#0a0f1a"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#d97706"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#b87a0d"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#cbd5e1"/>
                <Setter Property="Foreground" Value="#94a3b8"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text Button -->
    <Style TargetType="Button" x:Key="TextButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#d97706"/>
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Button -->
    <Style TargetType="Button" x:Key="IconButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox" x:Key="SearchTextBoxStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
