<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MORNING HUD: cool paper panels, deep ink, amber and cyan accents -->
    <LinearGradientBrush x:Key="PrimaryBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#F6F9FC" Offset="0"/>
        <GradientStop Color="#ECF3F8" Offset="0.55"/>
        <GradientStop Color="#E0ECF5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#EDF3F8" Offset="0"/>
        <GradientStop Color="#E2ECF4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F0F5F9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#EAF2F8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextColor" Color="#0A1522"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#314154"/>
    <SolidColorBrush x:Key="MutedTextColor" Color="#66768A"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentAmber" Color="#F3B234"/>
    <SolidColorBrush x:Key="SecondaryAccentCyan" Color="#238BCB"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="#168A62"/>
    <SolidColorBrush x:Key="WarningGold" Color="#B86F0B"/>
    <Color x:Key="CardShadowColor">#718399</Color>

    <!-- Alias brushes -->
    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#F6F9FC" Offset="0"/>
        <GradientStop Color="#ECF3F8" Offset="0.55"/>
        <GradientStop Color="#E0ECF5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F0F5F9" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E0EA"/>
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#EAF2F8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CharcoalBrush" Color="#0A1522"/>
    <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="#F3B234"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#F3B234"/>
    <SolidColorBrush x:Key="DarkModeTextBrush" Color="#0A1522"/>
    <SolidColorBrush x:Key="DarkModeSubtextBrush" Color="#66768A"/>
    <SolidColorBrush x:Key="DarkModeBorderBrush" Color="#D8E0EA"/>
    <SolidColorBrush x:Key="LightModeTextBrush" Color="#0A1522"/>
    <SolidColorBrush x:Key="LightModeSubtextBrush" Color="#66768A"/>
    <SolidColorBrush x:Key="LightModeBorderBrush" Color="#D8E0EA"/>

    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="SafetyOrange" Color="#F3B234"/>
    <SolidColorBrush x:Key="DeepCharcoal" Color="#0A1522"/>
    <SolidColorBrush x:Key="NavySidebar" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundGray" Color="#EEF3F8"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="#EAF0F6"/>
    <SolidColorBrush x:Key="BorderColor" Color="#D8E0EA"/>
    <SolidColorBrush x:Key="OrangeColor" Color="#F3B234"/>

    <!-- Gradient Brushes (Light Mode - bottom-left to top-right) -->
    <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#F6F9FC" Offset="0"/>
        <GradientStop Color="#ECF3F8" Offset="0.55"/>
        <GradientStop Color="#E0ECF5" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientCard" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F0F5F9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientHeader" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#238BCB" Offset="0"/>
        <GradientStop Color="#62B8E8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientButton" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#F3B234" Offset="0"/>
        <GradientStop Color="#D98A19" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientPanel" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#EAF2F8" Offset="1"/>
    </LinearGradientBrush>

    <!-- HUD Panel Style (gradient card with subtle border) -->
    <Style TargetType="Border" x:Key="HudPanelStyle">
        <Setter Property="Background" Value="{DynamicResource GradientPanel}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#22344A" BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Control Button -->
    <Style TargetType="Button" x:Key="WindowControlButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Button -->
    <Style TargetType="Button" x:Key="SidebarButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card Style -->
    <Style TargetType="Border" x:Key="CardStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Accent Button -->
    <Style TargetType="Button" x:Key="OrangeButtonStyle">
        <Setter Property="Background" Value="{DynamicResource GradientButton}"/>
        <Setter Property="Foreground" Value="#0a0f1a"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#d97706"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#b87a0d"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#cbd5e1"/>
                <Setter Property="Foreground" Value="#94a3b8"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text Button -->
    <Style TargetType="Button" x:Key="TextButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#d97706"/>
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Button -->
    <Style TargetType="Button" x:Key="IconButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox" x:Key="SearchTextBoxStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
