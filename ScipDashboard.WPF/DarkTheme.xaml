<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DARK MODE - SC-Truckers Night HUD Design System -->
    <!-- Deep-navy HUD theme with amber accent -->
    <!-- Background Colors -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#070b12"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#0d1520"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#131c28"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#162235"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextColor" Color="#ffffff"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#e0e0e0"/>
    <SolidColorBrush x:Key="MutedTextColor" Color="#b0b0b0"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentAmber" Color="#f5b32f"/>
    <SolidColorBrush x:Key="SecondaryAccentCyan" Color="#3ba8ff"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="#22c55e"/>
    <SolidColorBrush x:Key="WarningGold" Color="#ffd46b"/>

    <!-- Alias brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#070b12"/>
    <SolidColorBrush x:Key="CardBrush" Color="#131c28"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#27344d"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#070b12"/>
    <SolidColorBrush x:Key="CharcoalBrush" Color="#f0f2f5"/>
    <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="#f5b32f"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#f5b32f"/>
    <SolidColorBrush x:Key="DarkModeTextBrush" Color="#f0f2f5"/>
    <SolidColorBrush x:Key="DarkModeSubtextBrush" Color="#94a3b8"/>
    <SolidColorBrush x:Key="DarkModeBorderBrush" Color="#27344d"/>
    <SolidColorBrush x:Key="LightModeTextBrush" Color="#f0f2f5"/>
    <SolidColorBrush x:Key="LightModeSubtextBrush" Color="#94a3b8"/>
    <SolidColorBrush x:Key="LightModeBorderBrush" Color="#27344d"/>

    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="SafetyOrange">#f5b32f</SolidColorBrush>
    <SolidColorBrush x:Key="DeepCharcoal">#f0f2f5</SolidColorBrush>
    <SolidColorBrush x:Key="NavySidebar">#070b12</SolidColorBrush>
    <SolidColorBrush x:Key="BackgroundGray">#131c28</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackground">#131c28</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryBackground">#0d1520</SolidColorBrush>
    <SolidColorBrush x:Key="BorderColor">#27344d</SolidColorBrush>
    <SolidColorBrush x:Key="OrangeColor">#f5b32f</SolidColorBrush>

    <!-- Gradient Brushes (Dark Mode - bottom-left to top-right) -->
    <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#070b12" Offset="0"/>
        <GradientStop Color="#131c28" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientCard" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#162235" Offset="0"/>
        <GradientStop Color="#131c28" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientHeader" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#3ba8ff" Offset="0"/>
        <GradientStop Color="#6b9ff0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientButton" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#f5b32f" Offset="0"/>
        <GradientStop Color="#d97706" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientPanel" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#162235" Offset="0"/>
        <GradientStop Color="#131c28" Offset="1"/>
    </LinearGradientBrush>

    <!-- HUD Panel Style (gradient card with subtle border) -->
    <Style TargetType="Border" x:Key="HudPanelStyle">
        <Setter Property="Background" Value="{DynamicResource GradientPanel}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Window Control Button -->
    <Style TargetType="Button" x:Key="WindowControlButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Button -->
    <Style TargetType="Button" x:Key="SidebarButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card Style -->
    <Style TargetType="Border" x:Key="CardStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Accent Button -->
    <Style TargetType="Button" x:Key="OrangeButtonStyle">
        <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
        <Setter Property="Foreground" Value="#070b12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#d97706"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#b87a0d"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#334155"/>
                <Setter Property="Foreground" Value="#94a3b8"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text Button -->
    <Style TargetType="Button" x:Key="TextButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#d97706"/>
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Button -->
    <Style TargetType="Button" x:Key="IconButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox Style - Light bg, dark text in DarkTheme -->
    <Style TargetType="TextBox" x:Key="SearchTextBoxStyle">
        <Setter Property="Background" Value="#ffffff"/>
        <Setter Property="Foreground" Value="#070b12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox Style - Light bg, dark text in DarkTheme -->
    <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
        <Setter Property="Background" Value="#ffffff"/>
        <Setter Property="Foreground" Value="#070b12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBoxItem dropdown - Light bg, dark text -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#ffffff"/>
        <Setter Property="Foreground" Value="#070b12"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
                <Setter Property="Foreground" Value="#070b12"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
