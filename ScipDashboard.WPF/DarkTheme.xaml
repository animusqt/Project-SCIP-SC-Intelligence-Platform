<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NIGHT HUD: layered navy panels, warm amber and cool cyan accents -->
    <LinearGradientBrush x:Key="PrimaryBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#07111F" Offset="0"/>
        <GradientStop Color="#0A1B2D" Offset="0.55"/>
        <GradientStop Color="#10263A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#0C1A2A" Offset="0"/>
        <GradientStop Color="#112338" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#15273A" Offset="0"/>
        <GradientStop Color="#101D2D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#1A3045" Offset="0"/>
        <GradientStop Color="#132337" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextColor" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#C1CEDC"/>
    <SolidColorBrush x:Key="MutedTextColor" Color="#899AAF"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentAmber" Color="#F3B234"/>
    <SolidColorBrush x:Key="SecondaryAccentCyan" Color="#59B7FF"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="#35D39A"/>
    <SolidColorBrush x:Key="WarningGold" Color="#FFD46B"/>
    <Color x:Key="CardShadowColor">#000000</Color>

    <!-- Alias brushes -->
    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#07111F" Offset="0"/>
        <GradientStop Color="#0A1B2D" Offset="0.55"/>
        <GradientStop Color="#10263A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#15273A" Offset="0"/>
        <GradientStop Color="#101D2D" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BorderBrush" Color="#263A50"/>
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#091727" Offset="0"/>
        <GradientStop Color="#10263A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CharcoalBrush" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="#F3B234"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#F3B234"/>
    <SolidColorBrush x:Key="DarkModeTextBrush" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="DarkModeSubtextBrush" Color="#899AAF"/>
    <SolidColorBrush x:Key="DarkModeBorderBrush" Color="#263A50"/>
    <SolidColorBrush x:Key="LightModeTextBrush" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="LightModeSubtextBrush" Color="#899AAF"/>
    <SolidColorBrush x:Key="LightModeBorderBrush" Color="#263A50"/>

    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="SafetyOrange" Color="#F3B234"/>
    <SolidColorBrush x:Key="DeepCharcoal" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="NavySidebar" Color="#07111F"/>
    <SolidColorBrush x:Key="BackgroundGray" Color="#111F30"/>
    <SolidColorBrush x:Key="CardBackground" Color="#111F30"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="#0C1A2A"/>
    <SolidColorBrush x:Key="BorderColor" Color="#263A50"/>
    <SolidColorBrush x:Key="OrangeColor" Color="#F3B234"/>

    <!-- Gradient Brushes (Dark Mode - bottom-left to top-right) -->
    <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#07111F" Offset="0"/>
        <GradientStop Color="#0A1B2D" Offset="0.55"/>
        <GradientStop Color="#10263A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientCard" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#15273A" Offset="0"/>
        <GradientStop Color="#101D2D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientHeader" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#238BCB" Offset="0"/>
        <GradientStop Color="#59B7FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientButton" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#F3B234" Offset="0"/>
        <GradientStop Color="#D98A19" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientPanel" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#1A3045" Offset="0"/>
        <GradientStop Color="#132337" Offset="1"/>
    </LinearGradientBrush>

    <!-- HUD Panel Style (gradient card with subtle border) -->
    <Style TargetType="Border" x:Key="HudPanelStyle">
        <Setter Property="Background" Value="{DynamicResource GradientPanel}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.38"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Control Button -->
    <Style TargetType="Button" x:Key="WindowControlButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Button -->
    <Style TargetType="Button" x:Key="SidebarButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card Style -->
    <Style TargetType="Border" x:Key="CardStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Accent Button -->
    <Style TargetType="Button" x:Key="OrangeButtonStyle">
        <Setter Property="Background" Value="{DynamicResource GradientButton}"/>
        <Setter Property="Foreground" Value="#070b12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#d97706"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#b87a0d"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#334155"/>
                <Setter Property="Foreground" Value="#94a3b8"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text Button -->
    <Style TargetType="Button" x:Key="TextButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#d97706"/>
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Button -->
    <Style TargetType="Button" x:Key="IconButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox" x:Key="SearchTextBoxStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryOrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBoxItem dropdown -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
                <Setter Property="Foreground" Value="#070b12"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
