<UserControl x:Class="ScipDashboard.Modules.MainModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1160"
             Background="Transparent">
    
    <UserControl.Resources>
        <!-- Local styles for Dashboard -->
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource CharcoalBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <Style TargetType="Border" x:Key="DashboardCard">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ffa000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#ff8f00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Border" x:Key="ActionButtonBorder">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
            <Setter Property="Padding" Value="1"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Padding="24" Background="{DynamicResource SecondaryBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
            <StackPanel>
                <TextBlock Text="📊 Dashboard Overview" 
                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Welcome to the SC Intelligence Platform. Your logistics hub for Star Citizen."
                           Foreground="{DynamicResource DarkModeSubtextBrush}" FontSize="13"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Quick Actions -->
            <Border Grid.Row="0" Padding="20" Background="{DynamicResource SecondaryBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⚡ Quick Actions" 
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource ActionButtonBorder}">
                            <Button Content="📦 New Haul" Style="{StaticResource ActionButton}"/>
                        </Border>
                        <Border Style="{StaticResource ActionButtonBorder}">
                            <Button Content="🗺️ New Route" Style="{StaticResource ActionButton}"/>
                        </Border>
                        <Border Style="{StaticResource ActionButtonBorder}">
                            <Button Content="🔍 Market Scan" Style="{StaticResource ActionButton}"/>
                        </Border>
                        <Border Style="{StaticResource ActionButtonBorder}">
                            <Button Content="⛵ Add Ship" Style="{StaticResource ActionButton}"/>
                        </Border>
                        <Border Style="{StaticResource ActionButtonBorder}">
                            <Button Content="⭐ New Quest" Style="{StaticResource ActionButton}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Content Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Column: Recent Activity -->
                <Border Grid.Column="0" Padding="20" Background="{DynamicResource SecondaryBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="📋 Recent Activity" 
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,12"/>
                        
                        <!-- Activity Item 1 -->
                        <Border Padding="12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="M 0,0 L 10,5 L 0,10 Z" Fill="{DynamicResource PrimaryOrangeBrush}"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Application Started" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}"/>
                                    <TextBlock Text="Just now" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="System" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Activity Item 2 -->
                        <Border Padding="12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="M 2,2 L 8,2 L 8,8 L 2,8 Z" Fill="{DynamicResource SuccessGreen}"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="No active hauls" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}"/>
                                    <TextBlock Text="Create your first route to begin" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Hauling" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Activity Item 3 -->
                        <Border Padding="12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="M 5,2 L 9,6 L 5,10 L 1,6 Z" Fill="{DynamicResource PrimaryOrangeBrush}"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="No fleet configured" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}"/>
                                    <TextBlock Text="Add your ships to track cargo" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Fleet" FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <TextBlock Text="No recent activity" Foreground="{DynamicResource DarkModeSubtextBrush}" FontSize="12" 
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Right Column: System Status -->
                <Border Grid.Column="1" Padding="20" Background="{DynamicResource SecondaryBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="⚙️ System Status" 
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,12"/>
                        
                        <!-- Status Card: Core -->
                        <Border Padding="12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Core System" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}"/>
                                    <TextBlock Text="All modules loaded" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource SuccessGreen}" 
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Status Card: Data -->
                        <Border Padding="12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Data Cache" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}"/>
                                    <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource SuccessGreen}" 
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Status Card: Connection -->
                        <Border Padding="12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="External Data" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}"/>
                                    <TextBlock Text="Offline - Using cached data" FontSize="11" Foreground="{DynamicResource PrimaryOrangeBrush}"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource PrimaryOrangeBrush}" 
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Info Card -->
                        <Border Padding="16" Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="6" Margin="0,12,0,0" Opacity="0.1">
                            <StackPanel>
                                <TextBlock Text="💡 Tip" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryOrangeBrush}"/>
                                <TextBlock Text="Click 'Market Scan' to fetch latest commodity prices from uexcorp.space"
                                           FontSize="11" Foreground="{DynamicResource CharcoalBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
