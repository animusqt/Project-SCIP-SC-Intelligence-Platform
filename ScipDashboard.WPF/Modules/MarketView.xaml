<UserControl x:Class="ScipDashboard.WPF.Modules.MarketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression.blend/2008"
             xmlns:vm="clr-namespace:ScipDashboard.WPF.ViewModels"
             xmlns:converters="clr-namespace:ScipDashboard.WPF.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:MarketViewModel}">

    <UserControl.Resources>
        <converters:MarginToColorConverter x:Key="MarginToColor"/>
        <converters:RiskToColorConverter x:Key="RiskToColor"/>
        <converters:TrendToColorConverter x:Key="TrendToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="16,16,16,0">

            <!-- HEADER -->
            <Border Margin="0,0,0,16" Background="{DynamicResource GradientCard}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="8"
                            Margin="0,0,12,0">
                        <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Market Overview" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                        <TextBlock Text="live commodity data" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- QUICK STATS -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Best Gain" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding BestGainName, FallbackValue='Loading...'}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BestGainMargin, FallbackValue='+0.00%'}" FontSize="14" Foreground="{DynamicResource SuccessGreen}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Most Traded" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding MostTradedName, FallbackValue='Loading...'}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MostTradedMargin, FallbackValue='0.00%'}" FontSize="14" Foreground="{DynamicResource CharcoalBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Total Commodities" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Commodities.Count, FallbackValue=0}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Loading...'}" FontSize="12" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FILTER BAR -->
            <Border Margin="0,0,0,12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Padding="8,4" Margin="0,0,8,0"
                             Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource PrimaryTextColor}"/>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              Width="150" FontSize="11" Margin="0,0,8,0"
                              Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                              Foreground="{DynamicResource PrimaryTextColor}"/>

                    <Button Grid.Column="2" Content="🔄 Refresh" FontSize="11" Width="80" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Background="{DynamicResource PrimaryOrangeBrush}" Foreground="{DynamicResource PrimaryTextColor}"
                            BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- COMMODITY TABLE -->
            <Border Grid.IsSharedSizeScope="True" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="8,6"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160" SharedSizeGroup="ColCommodity"/>
                                <ColumnDefinition Width="80" SharedSizeGroup="ColBuy"/>
                                <ColumnDefinition Width="80" SharedSizeGroup="ColSell"/>
                                <ColumnDefinition Width="80" SharedSizeGroup="ColMargin"/>
                                <ColumnDefinition Width="80" SharedSizeGroup="ColVolume"/>
                                <ColumnDefinition Width="70" SharedSizeGroup="ColRisk"/>
                                <ColumnDefinition Width="80" SharedSizeGroup="ColTrend"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Commodity" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="0"/>
                            <TextBlock Text="Buy" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" Grid.Column="1" HorizontalAlignment="Right"/>
                            <TextBlock Text="Sell" FontSize="10" FontWeight="Bold" Foreground="#EF4444" Grid.Column="2" HorizontalAlignment="Right"/>
                            <TextBlock Text="Margin" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryOrangeBrush}" Grid.Column="3" HorizontalAlignment="Right"/>
                            <TextBlock Text="Volume" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="4" HorizontalAlignment="Right"/>
                            <TextBlock Text="Risk" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Trend" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Grid.Column="6" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Commodity Rows -->
                    <Border Grid.Row="1" Background="Transparent">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Commodities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                                Background="{DynamicResource CardBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Main Row -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="160" SharedSizeGroup="ColCommodity"/>
                                                        <ColumnDefinition Width="80" SharedSizeGroup="ColBuy"/>
                                                        <ColumnDefinition Width="80" SharedSizeGroup="ColSell"/>
                                                        <ColumnDefinition Width="80" SharedSizeGroup="ColMargin"/>
                                                        <ColumnDefinition Width="80" SharedSizeGroup="ColVolume"/>
                                                        <ColumnDefinition Width="70" SharedSizeGroup="ColRisk"/>
                                                        <ColumnDefinition Width="80" SharedSizeGroup="ColTrend"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Expand/Collapse Arrow -->
                                                    <Button Grid.Column="0" Width="24" Height="24" Padding="0" Margin="0" BorderThickness="0"
                                                            Background="Transparent" Foreground="{DynamicResource SecondaryTextColor}"
                                                            FontSize="10" FontWeight="Bold" Cursor="Hand"
                                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Command="{Binding ExpandCommand}" CommandParameter="{Binding Id}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="▼"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Content" Value="▲"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextColor}" Grid.Column="0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BuyPrice, StringFormat='{}{0:0}'}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessGreen}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SellPrice, StringFormat='{}{0:0}'}" FontSize="10" FontWeight="Bold"
                                                               Foreground="#EF4444" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Margin, StringFormat='{}{0:0.##}%'}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding Margin, Converter={StaticResource MarginToColor}}"
                                                               Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:#,##0}'}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"
                                                               Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RiskText}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskToColor}}"
                                                               Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Trend}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding Trend, Converter={StaticResource TrendToColor}}"
                                                               Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Station Details (Expandable) -->
                                                <Border Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                                        Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="0,0,6,6"
                                                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="12,8">
                                                    <ItemsControl ItemsSource="{Binding StationObservations}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource CardBrush}" CornerRadius="6"
                                                                        Margin="0,0,8,8" Padding="10,8" Width="210">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding LocationName}" FontSize="11" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4"/>
                                                                        <TextBlock Text="{Binding SystemName}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,6"/>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Grid.Column="0">
                                                                                <TextBlock Text="Buy" FontSize="8" Foreground="{DynamicResource MutedTextColor}"/>
                                                                                <TextBlock Text="{Binding BuyPrice, StringFormat='{}{0:0}'}" FontSize="11" FontWeight="Bold"
                                                                                           Foreground="{DynamicResource SuccessGreen}"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1">
                                                                                <TextBlock Text="Sell" FontSize="8" Foreground="{DynamicResource MutedTextColor}"/>
                                                                                <TextBlock Text="{Binding SellPrice, StringFormat='{}{0:0}'}" FontSize="11" FontWeight="Bold"
                                                                                           Foreground="#EF4444"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Margin, StringFormat='{}{0:0.##}%'}" FontSize="10" FontWeight="Bold"
                                                                                   Foreground="{Binding Margin, Converter={StaticResource MarginToColor}}" Margin="0,4,0,0"/>
                                                                        <TextBlock Text="{Binding SourceName}" FontSize="8" Foreground="{DynamicResource MutedTextColor}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Empty State -->
            <Border Margin="0,20,0,20" Background="{DynamicResource CardBrush}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="40"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="No commodities found" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try adjusting your filters or refreshing the data" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextColor}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </UserControl>
