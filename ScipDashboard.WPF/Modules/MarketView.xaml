<UserControl x:Class="ScipDashboard.WPF.Modules.MarketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ScipDashboard.WPF.ViewModels"
             xmlns:converters="clr-namespace:ScipDashboard.WPF.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:MarketViewModel}">
    <UserControl.Resources>
        <converters:MarginToColorConverter x:Key="MarginToColor"/>
        <converters:RiskToColorConverter x:Key="RiskToColor"/>
        <converters:TrendToColorConverter x:Key="TrendToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Background="{DynamicResource GradientCard}" BorderBrush="{DynamicResource PrimaryOrangeBrush}"
                    BorderThickness="0,0,0,2" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Market Overview" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                        <TextBlock Text="Browse the full SC DataHub reference catalog. Terminal inventory and cross-station spreads appear only when live observations are available."
                                   Foreground="{DynamicResource SecondaryTextColor}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataStatus, StringFormat={}Source: {0}}" Foreground="{DynamicResource SecondaryAccentCyan}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding LastUpdated, StringFormat={}Updated: {0:g}}" Foreground="{DynamicResource MutedTextColor}" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="12" Margin="0,0,8,0" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Best gain (risk-adjusted)" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding BestGainName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BestGainMargin}" Foreground="{DynamicResource SuccessGreen}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="12" Margin="4,0" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Most traded" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding MostTradedName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MostTradedVolume, StringFormat={}{0} SCU}" Foreground="{DynamicResource SecondaryAccentCyan}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="12" Margin="8,0,0,0" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Catalog coverage" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding Commodities.Count}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                    Padding="10" Margin="0,0,0,12">
                <WrapPanel VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="7" Margin="0,0,8,0"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="Search commodities"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="165" Padding="6" Margin="0,0,8,0"
                              Background="White" Foreground="#111111" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" Width="170" Padding="6" Margin="0,0,8,0"
                              Background="White" Foreground="#111111" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" Width="140" Padding="6" Margin="0,0,8,0"
                              Background="White" Foreground="#111111" BorderBrush="{DynamicResource BorderBrush}"/>
                    <Button Content="Sort direction" Command="{Binding ToggleSortCommand}" Padding="8,6" Margin="0,0,8,0"/>
                    <CheckBox Content="Watchlist only" IsChecked="{Binding IsFavoritesOnly}" VerticalAlignment="Center" Margin="4,0,12,0"
                              Foreground="{DynamicResource PrimaryTextColor}"/>
                    <Button Content="Refresh live data" Command="{Binding RefreshCommand}" Padding="9,6"
                            Background="{DynamicResource PrimaryOrangeBrush}" Foreground="#07111F" BorderThickness="0"/>
                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="9,6" Margin="8,0,0,0"/>
                </WrapPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentAmber}" BorderThickness="2"
                        Padding="14" Effect="{DynamicResource CardShadowEffect}">
                <StackPanel>
                    <TextBlock Text="Cargo trade planner" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="{Binding SelectedCommodity.Name, TargetNullValue=Select a commodity below to plan a trade.}"
                               Foreground="{DynamicResource SecondaryAccentCyan}" FontSize="13" Margin="0,3,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Buy location: " Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding SelectedCommodity.BuyLocation}" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,18,0"/>
                        <TextBlock Text="Sell location: " Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding SelectedCommodity.SellLocation}" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,18,0"/>
                        <TextBlock Text="Buy stock: " Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding AvailableBuyScu, StringFormat={}{0:N0} SCU}" Foreground="{DynamicResource SuccessGreen}" Margin="0,0,18,0"/>
                        <TextBlock Text="Sell demand: " Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding AvailableSellScu, StringFormat={}{0:N0} SCU}" Foreground="{DynamicResource SecondaryAccentCyan}"/>
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource MutedTextColor}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Buy boxes (SCU): {0} · loading {1}  |  Sell accepted boxes (SCU): {2} · loading {3}">
                                <Binding Path="SelectedCommodity.BuyContainerSizes"/>
                                <Binding Path="SelectedCommodity.BuyLoadingTime"/>
                                <Binding Path="SelectedCommodity.SellContainerSizes"/>
                                <Binding Path="SelectedCommodity.SellLoadingTime"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Trade amount" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding TradeQuantityScu, UpdateSourceTrigger=LostFocus}" Width="70" Padding="5" Margin="0,0,12,0"
                                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="Ship capacity" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding CargoCapacityScu, UpdateSourceTrigger=LostFocus}" Width="70" Padding="5" Margin="0,0,12,0"
                                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="{Binding CargoSpaceRemainingScu, StringFormat=Free: {0:N0} SCU}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryAccentCyan}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding PlannedTradeScu, StringFormat=Route quantity: {0:N0} SCU}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding ProjectedTradeProfit, StringFormat=Est. spread: {0:N0} aUEC}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SuccessGreen}" Margin="0,0,12,0"/>
                        <Button Content="Buy into cargo" Command="{Binding BuyCommand}" Padding="9,5" Margin="0,0,6,0"
                                Background="{DynamicResource PrimaryOrangeBrush}" Foreground="#07111F" BorderThickness="0"/>
                        <Button Content="Sell cargo" Command="{Binding SellCommand}" IsEnabled="{Binding CanSellSelectedCargo}" Padding="9,5"
                                Background="{DynamicResource SecondaryAccentCyan}" Foreground="#07111F" BorderThickness="0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding CurrentCargoScu, StringFormat=Loaded: {0:N0} SCU}" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,8,0,0"/>
                    <ItemsControl ItemsSource="{Binding TradeHistory}" MaxHeight="110" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:t}}"
                                           Foreground="{DynamicResource MutedTextColor}" FontSize="10">
                                    <TextBlock.ToolTip>
                                        <MultiBinding StringFormat="{}{0} {1:N0} SCU of {2} at {3}: {4:N0} aUEC/unit (profit {5:N0})">
                                            <Binding Path="Action"/><Binding Path="Scu"/><Binding Path="CommodityName"/>
                                            <Binding Path="Location"/><Binding Path="UnitPrice"/><Binding Path="Profit"/>
                                        </MultiBinding>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Border>

            <Grid>
                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                    <TextBlock Text="Commodity boards" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Padding="12,10"/>
                    <Border Background="{DynamicResource CardBrush}" Padding="10,7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Commodity" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}"/>
                            <TextBlock Grid.Column="1" Text="Buy / SCU" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessGreen}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Buy location" Margin="10,0,0,0" Foreground="{DynamicResource MutedTextColor}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="Sell / SCU" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryAccentCyan}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="Sell location" Margin="10,0,0,0" Foreground="{DynamicResource MutedTextColor}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="5" Text="Buy SCU" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextColor}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="6" Text="Sell SCU" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextColor}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="7" Text="Margin" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextColor}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="8" Text="Risk / 24h" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextColor}" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Commodities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="★" Command="{Binding DataContext.ToggleWatchlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}" Padding="2,0" BorderThickness="0"
                                                            Background="Transparent" Foreground="{DynamicResource PrimaryAccentAmber}" ToolTip="Toggle watchlist"/>
                                                    <Button Content="{Binding Name}" Command="{Binding DataContext.SelectCommodityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="0" BorderThickness="0"
                                                            Background="Transparent" Foreground="{DynamicResource PrimaryTextColor}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Category}" Margin="24,0,0,0" FontSize="9" Foreground="{DynamicResource MutedTextColor}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding BuyPriceText}" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding BuyLocation}" Margin="10,0,2,0" Foreground="{DynamicResource SecondaryTextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SellPriceText}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryAccentCyan}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SellLocation}" Margin="10,0,2,0" Foreground="{DynamicResource SecondaryTextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding BuyStock, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryTextColor}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding SellDemand, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryTextColor}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding MarginText}" HorizontalAlignment="Right"
                                                       Foreground="{Binding Margin, Converter={StaticResource MarginToColor}}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding RiskText}" HorizontalAlignment="Center" Foreground="{Binding Risk, Converter={StaticResource RiskToColor}}" FontSize="10"/>
                                                <TextBlock Text="{Binding Change24hText}" HorizontalAlignment="Center" Foreground="{Binding Trend, Converter={StaticResource TrendToColor}}" FontSize="9"/>
                                                <Polyline Points="{Binding TrendPoints}" Stroke="{Binding Trend, Converter={StaticResource TrendToColor}}"
                                                          StrokeThickness="1.5" Width="48" Height="16" Stretch="Fill"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                                Background="{DynamicResource SecondaryBackgroundBrush}" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                            <TextBlock Text="{Binding ReferenceMarginPerScu, StringFormat=SC DataHub listed margin: {0:N0} aUEC/SCU}"
                                                       Foreground="{DynamicResource PrimaryAccentAmber}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding UexAverageIndexText}"
                                                       Foreground="{DynamicResource SecondaryAccentCyan}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding UexAveragePricesText}" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                            <TextBlock Text="{Binding UexAverageSupplyDemandText}" Foreground="{DynamicResource MutedTextColor}" FontSize="10" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding StationObservations}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="9" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding LocationName}" Foreground="{DynamicResource PrimaryTextColor}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding SystemName}" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                                                        <TextBlock Foreground="{DynamicResource SuccessGreen}" Margin="0,4,0,0">
                                                                                            <TextBlock.Text>
                                                                                                <MultiBinding StringFormat="{}{0:N0} buy / {1:N0} SCU">
                                                                                                    <Binding Path="BuyPrice"/><Binding Path="Volume"/>
                                                                                                </MultiBinding>
                                                                                            </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Foreground="{DynamicResource SecondaryAccentCyan}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0:N0} sell / {1:N0} SCU">
                                                                            <Binding Path="SellPrice"/><Binding Path="DemandVolume"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding SupportedContainerSizes, StringFormat=Accepted box sizes: {0} SCU}"
                                                                           Foreground="{DynamicResource SecondaryAccentCyan}" FontSize="10" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding EstimatedLoadingTime, StringFormat=Estimated loading: {0}}"
                                                                           Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                                </StackPanel>
                                                            </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Station details" Command="{Binding ExpandCommand}" Padding="3,0" HorizontalAlignment="Right"
                                                Background="Transparent" Foreground="{DynamicResource SecondaryAccentCyan}" BorderThickness="0" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Padding="26" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No commodity observations match these filters." Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
