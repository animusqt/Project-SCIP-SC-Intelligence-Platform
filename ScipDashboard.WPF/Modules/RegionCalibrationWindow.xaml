<Window x:Class="ScipDashboard.WPF.Modules.RegionCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#99070D16"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="SelectionCanvas"
            Background="Transparent"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
        <StackPanel Canvas.Left="28" Canvas.Top="24" IsHitTestVisible="False">
            <TextBlock Text="SCIP GAME SCANNER — SELECT TERMINAL REGION"
                       Foreground="White" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Drag around the in-game commodity table. Release to save; press Esc to cancel."
                       Foreground="#DDE8F0" FontSize="14" Margin="0,6,0,0"/>
        </StackPanel>
        <Rectangle x:Name="SelectionRectangle"
                   Stroke="#00E5FF"
                   StrokeThickness="2"
                   Fill="#3300E5FF"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
    </Canvas>
</Window>
