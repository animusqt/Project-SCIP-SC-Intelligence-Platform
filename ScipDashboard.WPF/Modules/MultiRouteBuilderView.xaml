<UserControl x:Class="ScipDashboard.WPF.Modules.MultiRouteBuilderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="24">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="📊 Multi-Route Builder" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Compare and plan multiple routes" FontSize="12" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,0,0,16"/>
                    
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,16"/>
                    
                    <TextBlock Text="✅ Features:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                        <TextBlock Text="• Select multiple routes for comparison" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                        <TextBlock Text="• View stop counts and metrics side-by-side" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                        <TextBlock Text="• Compare gross margins and data confidence" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                        <TextBlock Text="• Save comparison plans" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                    </StackPanel>
                    
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>
                    
                    <TextBlock Text="Compare multiple routes to find the most profitable or efficient hauling strategy." FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
