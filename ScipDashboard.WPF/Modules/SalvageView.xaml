<UserControl x:Class="ScipDashboard.WPF.Modules.SalvageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ScipDashboard.WPF.ViewModels"
             xmlns:converters="clr-namespace:ScipDashboard.WPF.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:SalvageViewModel}">
    <UserControl.Resources>
        <converters:DataSourceStatusToTextConverter x:Key="StatusToText"/>
        <converters:MarginToColorConverter x:Key="MarginToColor"/>
        <converters:RiskToColorConverter x:Key="RiskToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Background="{DynamicResource GradientCard}" BorderBrush="{DynamicResource PrimaryOrangeBrush}"
                    BorderThickness="0,0,0,2" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Salvaging &amp; mining operations" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                        <TextBlock Text="Review commodity-backed resource locations and keep a local run ledger."
                                   Foreground="{DynamicResource SecondaryTextColor}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="10" Padding="9,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataStatus, Converter={StaticResource StatusToText}}" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Padding="12" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="Recorded runs" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding RecordedRuns}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Padding="12" Margin="4,0">
                    <StackPanel><TextBlock Text="Est. gross run value" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding TotalEstimatedProfit, StringFormat={}{0:N0} aUEC}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentAmber}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Padding="12" Margin="8,0,0,0">
                    <StackPanel><TextBlock Text="Average gross / hour" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding AverageEstimatedProfitPerHour, StringFormat={}{0:N0} aUEC/h}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentAmber}"
                    BorderThickness="2" Padding="14" Margin="0,0,0,12" Effect="{DynamicResource CardShadowEffect}">
                <StackPanel>
                    <TextBlock Text="Salvage &amp; mining operation planner" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="Choose a hazard band, target and hull to plan cargo capacity. Yields are your own estimates; no live field scan or in-game telemetry is available."
                               Foreground="{DynamicResource MutedTextColor}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Hazard band" Foreground="{DynamicResource MutedTextColor}"/>
                            <ComboBox ItemsSource="{Binding HazardBands}" SelectedItem="{Binding SelectedHazardBand}"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,4,8">
                            <TextBlock Text="Target / deposit" Foreground="{DynamicResource MutedTextColor}"/>
                            <ComboBox ItemsSource="{Binding TargetTypes}" SelectedItem="{Binding SelectedTargetType}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="Operation hull" Foreground="{DynamicResource MutedTextColor}"/>
                            <ComboBox ItemsSource="{Binding SalvageHulls}" SelectedItem="{Binding SelectedSalvageHull}"
                                      DisplayMemberPath="DisplayText"/>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel>
                        <TextBlock Text="{Binding SelectedHullCapacityText}" Foreground="{DynamicResource SecondaryAccentCyan}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding PlannedCargoTrips, StringFormat=Trips for entered yield: {0}}"
                                   Foreground="{DynamicResource PrimaryAccentAmber}"/>
                        <TextBlock Text="{Binding SelectedSalvageHull.Role, StringFormat=Suggested role: {0}}"
                                   Foreground="{DynamicResource SecondaryTextColor}" Margin="16,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="Component &amp; material value references (community estimates; verify in-game)"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding ComponentReferences}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Padding="8" Margin="0,0,7,7" MaxWidth="230">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource SecondaryAccentCyan}" FontSize="9"/>
                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource PrimaryAccentAmber}"/>
                                        <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource MutedTextColor}" FontSize="9" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Strip mounted components before hull scraping; recovered equipment is not guaranteed and these values are not live shop quotes."
                               Foreground="{DynamicResource MutedTextColor}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentAmber}" BorderThickness="2"
                    Padding="14" Margin="0,0,0,12" Effect="{DynamicResource CardShadowEffect}">
                <StackPanel>
                    <TextBlock Text="Log a run" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Activity" Foreground="{DynamicResource MutedTextColor}"/>
                            <ComboBox ItemsSource="{Binding ActivityTypes}" SelectedItem="{Binding OperationType}" Padding="6"
                                      Background="White" Foreground="#111111"/></StackPanel>
                        <StackPanel Margin="4,0,4,8"><TextBlock Text="Location / field" Foreground="{DynamicResource MutedTextColor}"/>
                            <TextBox Text="{Binding OperationLocation, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                        <StackPanel Margin="8,0,0,8"><TextBlock Text="Resource / salvage material" Foreground="{DynamicResource MutedTextColor}"/>
                            <TextBox Text="{Binding OperationResource, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Recovered yield (SCU)" Foreground="{DynamicResource MutedTextColor}"/>
                            <TextBox Text="{Binding OperationYieldScu, UpdateSourceTrigger=LostFocus}" Padding="6"
                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                        <StackPanel Margin="4,0,4,8"><TextBlock Text="Duration (minutes)" Foreground="{DynamicResource MutedTextColor}"/>
                            <TextBox Text="{Binding OperationDurationMinutes, UpdateSourceTrigger=LostFocus}" Padding="6"
                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                        <StackPanel Margin="8,0,0,8"><TextBlock Text="Estimated sell price / SCU" Foreground="{DynamicResource MutedTextColor}"/>
                            <TextBox Text="{Binding OperationPricePerScu, UpdateSourceTrigger=LostFocus}" Padding="6"
                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                    </UniformGrid>
                    <DockPanel>
                        <Button Content="Save run" Command="{Binding AddOperationCommand}" Padding="10,6"
                                Background="{DynamicResource PrimaryOrangeBrush}" Foreground="#07111F" BorderThickness="0"/>
                        <TextBlock Text="{Binding OperationEstimatedProfit, StringFormat={}{0:N0} aUEC gross}"
                                   Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center" Margin="12,0"/>
                        <TextBlock Text="{Binding OperationEstimatedProfitPerHour, StringFormat={}{0:N0} aUEC/h}"
                                   Foreground="{DynamicResource SecondaryAccentCyan}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,8,0,0"/>
                    <TextBlock Text="Run values are user estimates, not live field scans or guaranteed sale proceeds."
                               Foreground="{DynamicResource MutedTextColor}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                    Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Resource market locations" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="SCU reflects the last market observation available to this dashboard, not remaining field deposits."
                               Foreground="{DynamicResource MutedTextColor}" FontSize="10" Margin="0,3,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="6" Margin="0,0,8,0"
                                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"
                                 ToolTip="Search resource location"/>
                        <ComboBox ItemsSource="{Binding LocationNames}" SelectedItem="{Binding SelectedLocation}" Width="170" Padding="6"
                                  Background="White" Foreground="#111111" BorderBrush="{DynamicResource BorderBrush}"/>
                    </WrapPanel>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.7*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Location" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="System / mode" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="Top commodity" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="Items" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}"/>
                            <TextBlock Grid.Column="4" Text="Supply SCU" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="5" Text="Demand SCU" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="6" Text="Margin" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Locations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="0.7*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding LocationName}" Foreground="{DynamicResource PrimaryTextColor}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding SystemName}" Foreground="{DynamicResource SecondaryTextColor}"/>
                                            <TextBlock Text="{Binding ActivityType}" Foreground="{DynamicResource SecondaryAccentCyan}" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TopResource}" Foreground="{DynamicResource PrimaryTextColor}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SalvageItems}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextColor}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding YieldText}" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessGreen}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding DemandText}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryAccentCyan}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding ProfitText}" HorizontalAlignment="Right"
                                                   Foreground="{Binding AverageProfitPercent, Converter={StaticResource MarginToColor}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Padding="18" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No resource commodity observations match the current filters." Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Padding="14">
                <StackPanel>
                    <TextBlock Text="Run history" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding OperationRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource PrimaryTextColor}" FontWeight="Bold">
                                                <TextBlock.Text><MultiBinding StringFormat="{}{0} - {1}"><Binding Path="ActivityType"/><Binding Path="Resource"/></MultiBinding></TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource SecondaryTextColor}">
                                                <TextBlock.Text><MultiBinding StringFormat="{}{0} | {1:N0} SCU | {2} min">
                                                    <Binding Path="Location"/><Binding Path="YieldScu"/><Binding Path="DurationMinutes"/>
                                                </MultiBinding></TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource SuccessGreen}">
                                                <TextBlock.Text><MultiBinding StringFormat="Est. {0:N0} aUEC ({1:N0}/h)">
                                                    <Binding Path="EstimatedProfit"/><Binding Path="EstimatedProfitPerHour"/>
                                                </MultiBinding></TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove" Command="{Binding DataContext.RemoveOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="7,4" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
