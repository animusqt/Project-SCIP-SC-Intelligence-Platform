<UserControl x:Class="ScipDashboard.WPF.Modules.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <Border Background="{DynamicResource GradientCard}" BorderBrush="{DynamicResource PrimaryOrangeBrush}"
                    BorderThickness="0,0,0,2" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Fleet operations" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="Maintain your ship roster, cargo assignments, and current locations."
                               Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextColor}"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="14" Margin="0,0,8,0" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel><TextBlock Text="Ships in fleet" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding FleetShipCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="14" Margin="4,0" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel><TextBlock Text="Total cargo capacity" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding FleetCapacity, StringFormat={}{0:N0} SCU}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentAmber}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="14" Margin="8,0,0,0" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel><TextBlock Text="Cargo assigned" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding CargoLoaded, StringFormat={}{0:N0} SCU}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentCyan}"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="2" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="My fleet" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding OwnedShips}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MinHeight="130" MaxHeight="280"
                              Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              RowBackground="{DynamicResource CardBrush}" AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ship" Binding="{Binding Name}" IsReadOnly="True" Width="1.5*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" IsReadOnly="True" Width="1.1*"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="0.7*"/>
                            <DataGridTextColumn Header="Capacity / ship" Binding="{Binding CargoCapacityScu}" IsReadOnly="True" Width="1.1*"/>
                            <DataGridTextColumn Header="Cargo loaded" Binding="{Binding CargoLoadedScu, UpdateSourceTrigger=LostFocus}" Width="1*"/>
                            <DataGridTextColumn Header="Current location" Binding="{Binding CurrentLocation, UpdateSourceTrigger=LostFocus}" Width="1.3*"/>
                            <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment, UpdateSourceTrigger=LostFocus}" Width="1.1*"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Padding="6,3"
                                                Command="{Binding DataContext.RemoveShipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextColor}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Padding="16">
                <StackPanel>
                    <TextBlock Text="Ship catalog" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,8"/>
                    <TextBlock Foreground="{DynamicResource MutedTextColor}" FontSize="10" Margin="0,0,0,8">
                        <Run Text="{Binding CatalogCount}"/>
                        <Run Text=" ships from the SC-Truckers fleet reference snapshot (2026-11-01). Data may change on the source site."/>
                    </TextBlock>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             ToolTip="Search ship, manufacturer, or role"/>
                    <ItemsControl ItemsSource="{Binding VisibleCatalog}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Padding="12" Margin="0,0,8,8" Width="280">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Manufacturer}" Foreground="{DynamicResource MutedTextColor}" Margin="0,3"/>
                                        <TextBlock Text="{Binding Role}" Foreground="{DynamicResource SecondaryTextColor}"/>
                                        <TextBlock Text="{Binding AvailabilityStatus, StringFormat=Status: {0}}" Foreground="{DynamicResource MutedTextColor}" Margin="0,3"/>
                                        <TextBlock Text="{Binding CargoCapacityScu, StringFormat={}{0:N0} SCU}" Foreground="{DynamicResource SecondaryAccentCyan}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding PledgePrice, StringFormat=Pledge: {0}}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AuecPrice, StringFormat=aUEC: {0}}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CrewRange, StringFormat=Crew: {0}}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MaxBoxSize, StringFormat=Max box: {0}}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LoadingSupport, StringFormat=Loading: {0}}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding BestForLoadout}" Foreground="{DynamicResource PrimaryAccentAmber}" Margin="0,5,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,0,0,8">
                                            <Hyperlink NavigateUri="{Binding RsiSpecsUri}" RequestNavigate="OnRsiSpecsNavigate">Official RSI ship specs ↗</Hyperlink>
                                        </TextBlock>
                                        <Button Content="Add to my fleet" Command="{Binding DataContext.AddShipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" Padding="8,5"
                                                Background="{DynamicResource PrimaryOrangeBrush}" Foreground="#07111F" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
