<UserControl x:Class="ScipDashboard.WPF.Modules.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression.blend/2008"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="24">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="⛵ Fleet" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Searchable directory of Star Citizen ships and your personal fleet" FontSize="12" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,0,0,16"/>
                    
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,16"/>
                    
                    <TextBlock Text="✅ Coming Soon:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CharcoalBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                        <TextBlock Text="• Ship Catalog - Search and filter all known Star Citizen ships" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                        <TextBlock Text="• My Fleet - Track your owned and desired ships" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                        <TextBlock Text="• Ship Details - Complete specifications and provenance" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                        <TextBlock Text="• Fleet Status - Monitor locations, cargo, and assignments" FontSize="11" Foreground="{DynamicResource DarkModeSubtextBrush}" Margin="0,2,0,2"/>
                    </StackPanel>
                    
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>
                    
                    <TextBlock Text="The fleet module will provide a complete, searchable catalog of all Star Citizen ships with the ability to track your personal collection." FontSize="10" Foreground="{DynamicResource DarkModeSubtextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
