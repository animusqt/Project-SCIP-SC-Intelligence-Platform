<UserControl x:Class="ScipDashboard.WPF.Modules.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression.blend/2008"
             xmlns:local="clr-namespace:ScipDashboard.WPF.Modules"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="StatCardStyle">
            <Setter Property="Background" Value="{DynamicResource GradientCard}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,16,16,0">

            <!-- ==================== HEADER ==================== -->
            <Border Margin="0,0,0,20" Background="{DynamicResource GradientCard}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="10"
                                Margin="0,0,12,0">
                            <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Main Kiosk" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                            <TextBlock Text="Welcome to SC Intelligence Platform" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Status Badge -->
                    <Border Grid.Column="1" Background="{DynamicResource SuccessGreen}" CornerRadius="12" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0"/>
                            <TextBlock Text="System Online" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== QUICK STAT CARDS ==================== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Profit -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Profit" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="+284,500 aUEC" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4"/>
                        <TextBlock Text="+12.4% vs last week" FontSize="9" Foreground="{DynamicResource SuccessGreen}"/>
                    </StackPanel>
                </Border>

                <!-- Runs Completed -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Hauling Runs" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="42" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4"/>
                        <TextBlock Text="8 this week" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>

                <!-- Active Routes -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Active Routes" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="12" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4"/>
                        <TextBlock Text="3 high margin" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>

                <!-- Fleet Value -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Fleet Value" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="2.1M aUEC" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4"/>
                        <TextBlock Text="4 ships" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== SHORTCUT BUTTONS ==================== -->
            <Border Margin="0,0,0,16" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Quick Access" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="📊 Market Overview" FontSize="12" Padding="12,14" Margin="0,0,6,0"
                                Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource PrimaryTextColor}" Click="OnMarketClick"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
                                            <Setter Property="Foreground" Value="#070b12"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1" Content="🚚 Hauling Routes" FontSize="12" Padding="12,14" Margin="6,0,6,0"
                                Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource PrimaryTextColor}" Click="OnHaulingClick"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
                                            <Setter Property="Foreground" Value="#070b12"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="2" Content="🚀 Fleet Manager" FontSize="12" Padding="12,14" Margin="6,0,0,0"
                                Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource PrimaryTextColor}" Click="OnFleetClick"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
                                            <Setter Property="Foreground" Value="#070b12"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="3" Content="⚙️ Settings" FontSize="12" Padding="12,14" Margin="0,0,6,0"
                                Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource PrimaryTextColor}" Click="OnSettingsClick"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
                                            <Setter Property="Foreground" Value="#070b12"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== RECENT ACTIVITY ==================== -->
            <Border Margin="0,0,0,20" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Recent Activity" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,12"/>

                    <ListView Grid.Row="1" BorderThickness="0" Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                                    CornerRadius="6">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        CornerRadius="6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextColor}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="9" Foreground="{DynamicResource MutedTextColor}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.Items>
                            <local:ActivityItem Icon="📦" Title="Market data refreshed" Subtitle="47 commodities updated from UEXCorp" Time="2 min ago"/>
                            <local:ActivityItem Icon="🚚" Title="Haul completed" Subtitle="Waste: MIC-L5 → Everus Harbor (+1,240 aUEC)" Time="15 min ago"/>
                            <local:ActivityItem Icon="💰" Title="Profit milestone" Subtitle="Reached 250k total profit" Time="1 hour ago"/>
                            <local:ActivityItem Icon="🚀" Title="Ship added" Subtitle="Cutlass Black added to fleet" Time="3 hours ago"/>
                            <local:ActivityItem Icon="🗺️" Title="Route created" Subtitle="New Babbage → Port Olisar loop saved" Time="5 hours ago"/>
                        </ListView.Items>
                    </ListView>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
