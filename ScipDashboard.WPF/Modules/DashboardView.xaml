<UserControl x:Class="ScipDashboard.WPF.Modules.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DesignHeight="760" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <Border Background="{DynamicResource GradientCard}" BorderBrush="{DynamicResource PrimaryAccentAmber}"
                    BorderThickness="2" Padding="22" Margin="0,0,0,14" Effect="{DynamicResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="SC-TRUCKERS // LOGISTICS AND COMMODITY" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryAccentCyan}" Margin="0,0,0,8"/>
                        <TextBlock Text="Reliable hauls. Profitable salvage. Built for citizens."
                                   FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextColor}"/>
                        <TextBlock Text="Live commodity boards, route planning, fleet management, and verse operations in one cockpit."
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,8,0,14"/>
                        <WrapPanel>
                            <Button Content="Build a route" Click="OnHaulingClick" Padding="14,8" Margin="0,0,8,6"
                                    Background="{DynamicResource PrimaryAccentAmber}" Foreground="#07111F" BorderThickness="0"
                                    FontWeight="Bold" Cursor="Hand"/>
                            <Button Content="View market" Click="OnMarketClick" Padding="14,8" Margin="0,0,8,6"
                                    Background="{DynamicResource SecondaryAccentCyan}" Foreground="#07111F" BorderThickness="0"
                                    FontWeight="Bold" Cursor="Hand"/>
                            <Button Content="Scan a board" Click="OnScanClick" Padding="14,8" Margin="0,0,8,6"
                                    Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Top" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel MaxWidth="220">
                            <TextBlock Text="{Binding MarketStatus}" FontSize="12" FontWeight="Bold"
                                       Foreground="{Binding MarketStatusBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MarketSource}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextColor}" Margin="0,5,0,10"/>
                            <Button Content="Refresh market" Command="{Binding RefreshCommand}"
                                    Padding="9,5" HorizontalAlignment="Left"
                                    Background="{DynamicResource SecondaryBackgroundBrush}"
                                    Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/>
                            <TextBlock Text="{Binding UpdatedAt, StringFormat=Updated: {0}}" FontSize="9"
                                       Foreground="{DynamicResource MutedTextColor}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="-4,0,-4,12">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="12" Margin="4" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Tracked commodities" FontSize="10" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding TrackedCommodities}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                        <TextBlock Text="SC DataHub catalog" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="12" Margin="4" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Live terminals" FontSize="10" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding ObservedTerminals}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentCyan}"/>
                        <TextBlock Text="From current live observations" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="12" Margin="4" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Profitable cross-terminal spreads" FontSize="10" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding ProfitableSpreads}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}"/>
                        <TextBlock Text="Only counted from live prices" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="12" Margin="4" Effect="{DynamicResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Top listed margin" FontSize="10" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Text="{Binding BestMargin}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentAmber}"/>
                        <TextBlock Text="Reference or live, see row source" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="2" Padding="14" Margin="0,0,0,14" Effect="{DynamicResource CardShadowEffect}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Verse Market News" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                            <TextBlock Text="{Binding VerseMarketBrief}"
                                       FontSize="10" Foreground="{DynamicResource MutedTextColor}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="View all ›" Click="OnMarketClick" Padding="10,5"
                                Background="Transparent" Foreground="{DynamicResource SecondaryAccentCyan}" BorderThickness="0"
                                VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.7*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Commodity" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Column="1" Text="Buy" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Buy location" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Margin="8,0"/>
                        <TextBlock Grid.Column="3" Text="Sell" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="Sell location" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" Margin="8,0"/>
                        <TextBlock Grid.Column="5" Text="Margin/SCU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="Source" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TopCommodities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="7,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BuyPrice, StringFormat={}{0:N0}}" FontSize="9" Foreground="{DynamicResource PrimaryTextColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BuyLocation}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SellPrice, StringFormat={}{0:N0}}" FontSize="9" Foreground="{DynamicResource PrimaryTextColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SellLocation}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="5" Text="{Binding MarginPerScu, StringFormat={}{0:N0}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Source}" FontSize="9" Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Latest from the 'verse" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="Open the official Star Citizen Spectrum news and community feed. The dashboard does not invent headlines when a supported feed is unavailable."
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,4,0,8"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://robertsspaceindustries.com/spectrum/community/SC"
                                   RequestNavigate="OnSpectrumNavigate">
                            Official RSI Spectrum ↗
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="Where to go next" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,8"/>
            <UniformGrid Columns="2" Margin="-4,0,-4,12">
                <Button Click="OnHaulingClick" HorizontalContentAlignment="Stretch" Padding="14" Margin="4"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="HAULING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentCyan}"/>
                        <TextBlock Text="Multi-stop routes" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,3"/>
                        <TextBlock Text="Pack cargo, compare price boards, and plan your next run." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Button>
                <Button Click="OnSalvageClick" HorizontalContentAlignment="Stretch" Padding="14" Margin="4"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="SALVAGE &amp; MINING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentAmber}"/>
                        <TextBlock Text="Operations log" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,3"/>
                        <TextBlock Text="Review resource markets and record estimated operation yields." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Button>
                <Button Click="OnFleetClick" HorizontalContentAlignment="Stretch" Padding="14" Margin="4"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="FLEET" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentCyan}"/>
                        <TextBlock Text="Ship roster" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,3"/>
                        <TextBlock Text="Search the spacecraft catalog, manage your ships, and assign cargo." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Button>
                <Button Click="OnStarQuesterClick" HorizontalContentAlignment="Stretch" Padding="14" Margin="4"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="REPUTATION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentAmber}"/>
                        <TextBlock Text="Quest journal" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,3"/>
                        <TextBlock Text="Track contract notes and faction progress recorded in your journal." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColor}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
