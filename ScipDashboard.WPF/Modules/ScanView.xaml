<UserControl x:Class="ScipDashboard.WPF.Modules.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression.blend/2008"
             xmlns:vm="clr-namespace:ScipDashboard.WPF.ViewModels"
             xmlns:converters="clr-namespace:ScipDashboard.WPF.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}">

    <UserControl.Resources>
        <converters:MarginToColorConverter x:Key="MarginToColor"/>
        <converters:BoolNegationConverter x:Key="BoolNegation"/>
        
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style TargetType="Button" x:Key="ScanButtonStyle">
            <Setter Property="Background" Value="{DynamicResource PrimaryOrangeBrush}"/>
            <Setter Property="Foreground" Value="#070b12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style TargetType="Button" x:Key="ClearButtonStyle">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,16,16,0">

            <!-- HEADER -->
            <Border Margin="0,0,0,20" Background="{DynamicResource GradientCard}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="{DynamicResource PrimaryOrangeBrush}" CornerRadius="10"
                            Margin="0,0,12,0">
                        <TextBlock Text="📷" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="OCR | SCAN" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                        <TextBlock Text="Upload scanner data to update market prices" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SCAN INPUT AREA -->
            <Border Margin="0,0,0,16" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Scanner Data Input" Style="{StaticResource SectionHeader}"/>
                    
                    <TextBlock Text="Paste scanner JSON or CSV data below:" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,6"/>
                    
                    <TextBox x:Name="ScanInputTextBox"
                             Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="140"
                             FontFamily="Consolas"
                             FontSize="11"
                             Padding="8"
                             Margin="0,0,0,12"
                             Background="{DynamicResource CardBrush}"
                             Foreground="{DynamicResource PrimaryTextColor}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"/>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Content="SCAN &amp; UPDATE MARKET" Command="{Binding ScanInputCommand}"
                                Style="{StaticResource ScanButtonStyle}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}"
                                Style="{StaticResource ClearButtonStyle}"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- SCAN RESULTS -->
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Scan Results" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding Results.Count}" Grid.Column="1" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryOrangeBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="6" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6"
                                                Margin="0,0,0,6" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                 
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding CommodityName}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextColor}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LocationName}" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                                                    <TextBlock Text="{Binding SystemName}" FontSize="9" Foreground="{DynamicResource MutedTextColor}"/>
                                                </StackPanel>
                                                 
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                    <TextBlock Text="Buy" FontSize="9" Foreground="{DynamicResource MutedTextColor}"/>
                                                    <TextBlock Text="{Binding BuyText}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessGreen}"/>
                                                </StackPanel>
                                                 
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                    <TextBlock Text="Sell" FontSize="9" Foreground="{DynamicResource MutedTextColor}"/>
                                                    <TextBlock Text="{Binding SellText}" FontSize="12" FontWeight="Bold"
                                                               Foreground="#EF4444"/>
                                                </StackPanel>
                                                 
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                    <TextBlock Text="Margin" FontSize="9" Foreground="{DynamicResource MutedTextColor}"/>
                                                    <TextBlock Text="{Binding MarginText}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{Binding Margin, Converter={StaticResource MarginToColor}}"/>
                                                </StackPanel>
                                                 
                                                <StackPanel Grid.Column="4" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessGreen}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- COMING SOON: Advanced Scanner Features -->
            <Border Margin="0,20,0,0" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔮" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Coming Soon — Advanced Scanner" Style="{StaticResource SectionHeader}"/>
                    </StackPanel>
                    <TextBlock Text="Planned features for the SC Price Scanner overlay integration:" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    
                    <ItemsControl ItemsSource="{Binding ComingSoonItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="✦" FontSize="11" Foreground="{DynamicResource PrimaryOrangeBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FeatureName}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextColor}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FeatureDescription}" FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap"
                                               Margin="20,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

