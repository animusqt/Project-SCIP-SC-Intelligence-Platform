<UserControl x:Class="ScipDashboard.WPF.Modules.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ScipDashboard.WPF.ViewModels"
             xmlns:converters="clr-namespace:ScipDashboard.WPF.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}">
    <UserControl.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegation"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Background="{DynamicResource GradientCard}" BorderBrush="{DynamicResource PrimaryOrangeBrush}"
                    BorderThickness="0,0,0,2" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="OCR market scanner" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="Read terminal screenshots, inspect confidence, edit every field, then explicitly apply reviewed prices."
                               Foreground="{DynamicResource SecondaryTextColor}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                    Padding="14" Margin="0,0,0,12" Effect="{DynamicResource CardShadowEffect}">
                <StackPanel>
                    <TextBlock Text="Image or scanner data" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="Scan a saved game-screen region with F9, choose an image, or paste scanner JSON/CSV or SC DataHub data."
                               Foreground="{DynamicResource MutedTextColor}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ScannerRegionSummary}" Foreground="{DynamicResource SecondaryAccentCyan}"
                               FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <UniformGrid Columns="3" Margin="0,0,0,9">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Station / terminal scanned" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                            <TextBox Text="{Binding ScanStationName, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}"
                                     BorderBrush="{DynamicResource BorderBrush}" ToolTip="Enter the exact station or terminal name"/>
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Star system" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                            <ComboBox ItemsSource="{Binding StarSystems}" SelectedItem="{Binding ScanSystemName}"
                                      Padding="6" Background="White" Foreground="#111111"
                                      BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Terminal view" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                            <ComboBox ItemsSource="{Binding ObservationTabs}" SelectedItem="{Binding SelectedObservationTab}"
                                      Padding="6"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Buy tab: read price/SCU and SHOP QUANTITY (current station stock). Local Value: read price/SCU and supported cargo sizes. Its 0 SCU is your current cargo, not station demand, so it is not added as sell demand."
                               Foreground="{DynamicResource MutedTextColor}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="90" MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="9" FontFamily="Consolas"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextColor}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,9"/>
                    <WrapPanel>
                        <Button Content="Select game region (F8)" Click="CalibrateRegion_Click" Padding="10,6" Margin="0,0,8,0"/>
                        <Button Content="Capture saved region (F9)" Command="{Binding CaptureRegionCommand}" Padding="10,6" Margin="0,0,8,0"/>
                        <Button Content="Open image / data file" Command="{Binding BrowseFileCommand}" Padding="10,6" Margin="0,0,8,0"/>
                        <Button Content="Extract editable rows" Command="{Binding ScanInputCommand}" Padding="10,6"
                                Background="{DynamicResource SecondaryAccentCyan}" Foreground="#07111F" BorderThickness="0" Margin="0,0,8,0"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource BoolNegation}}"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}" Padding="10,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ScanFileName}" Foreground="{DynamicResource SecondaryAccentCyan}" FontSize="10" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="Image OCR uses the Windows language packs installed on this PC. Low-confidence rows should be verified before applying."
                               Foreground="{DynamicResource MutedTextColor}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="In-game workflow: switch Star Citizen to borderless/windowed mode, press F8 and drag over the terminal table, then press F9. The dashboard can stay in the background; staged rows appear here for review."
                               Foreground="{DynamicResource MutedTextColor}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentAmber}" BorderThickness="2"
                    Padding="14" Effect="{DynamicResource CardShadowEffect}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Review and edit scan rows" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                            <TextBlock Text="{Binding Results.Count, StringFormat={}{0} staged row(s) - nothing is applied until you confirm.}"
                                       FontSize="10" Foreground="{DynamicResource MutedTextColor}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Export CSV" Command="{Binding ExportResultsCommand}" Padding="9,5" Margin="0,0,7,0"/>
                            <Button Content="Apply reviewed prices" Command="{Binding SaveToMarketCommand}" IsEnabled="{Binding IsSaveEnabled}"
                                    Padding="9,5" Background="{DynamicResource PrimaryOrangeBrush}" Foreground="#07111F" BorderThickness="0"/>
                        </WrapPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ConfidenceText}" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentCyan}"/>
                                                <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource MutedTextColor}" Margin="8,0"/>
                                                <TextBlock Text="{Binding ScanType}" Foreground="{DynamicResource SecondaryTextColor}" Margin="8,0"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryAccentAmber}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Remove row"
                                                    Command="{Binding DataContext.RemoveResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="7,3"/>
                                        </Grid>
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Commodity" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding CommodityName, UpdateSourceTrigger=LostFocus}" Width="185" Padding="5"
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Location" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding LocationName, UpdateSourceTrigger=LostFocus}" Width="175" Padding="5"
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="System" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                             <ComboBox ItemsSource="{Binding DataContext.StarSystems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       SelectedItem="{Binding SystemName, UpdateSourceTrigger=LostFocus}" Width="105" Padding="5"
                                                                       Background="White" Foreground="#111111" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Buy price / SCU" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding BuyPrice, UpdateSourceTrigger=LostFocus}" Width="90" Padding="5"
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Sell price / SCU" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding SellPrice, UpdateSourceTrigger=LostFocus}" Width="90" Padding="5"
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Buy stock SCU" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding Volume, UpdateSourceTrigger=LostFocus}" Width="85" Padding="5"
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Observed sell demand SCU (optional)" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding DemandVolume, UpdateSourceTrigger=LostFocus}" Width="85" Padding="5"
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Accepted cargo sizes (SCU)" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding SupportedContainerSizesText, UpdateSourceTrigger=LostFocus}" Width="150" Padding="5"
                                                         ToolTip="Enter supported box sizes, e.g. 1, 2, 4, 8, 16, 24, 32"
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Estimated loading time (HH:MM:SS)" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBox Text="{Binding EstimatedLoadingTimeText, UpdateSourceTrigger=LostFocus}" Width="145" Padding="5"
                                                         ToolTip="Captured from the terminal when visible; this can vary by commodity and selected load."
                                                         Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextColor}" BorderBrush="{DynamicResource BorderBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Margin" Foreground="{DynamicResource MutedTextColor}" FontSize="10"/>
                                                <TextBlock Text="{Binding MarginText}" Width="74" Padding="5" Foreground="{DynamicResource SuccessGreen}" FontWeight="Bold"/></StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Visibility="{Binding IsSaveEnabled, Converter={StaticResource InverseBooleanToVisibility}}" Padding="22">
                        <TextBlock Text="Import or scan a file to stage rows for review." Foreground="{DynamicResource MutedTextColor}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
