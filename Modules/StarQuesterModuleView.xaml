<UserControl x:Class="ScipDashboard.Modules.StarQuesterModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="StarQuester" FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>
            <TextBlock Text="Quest capture and faction-reputation guidance" FontSize="14" Foreground="#666" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="20" Background="White" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Quest Capture" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Paste or upload quest details to begin." FontStyle="Italic" Foreground="#999" TextWrapping="Wrap" MaxWidth="400"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
