<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/twin"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             x:Class="ScipDashboard.Modules.Crew.CrewModuleView"
             x:Name="CrewView">
    <UserControl.Resources>
        <Style x:Key="CrewCard" TargetType="Border">
            <Setter Property="Background" Value="#2c3e50"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20">
            <TextBlock Text="Crew Directory" FontSize="24" FontWeight="Bold" Foreground="#FFC107"/>
            <TextBox   Width="300" Margin="20,0,0,0" HorizontalAlignment="Left"
                     x:Name="SearchBox"
                     Tag="Search crew by name or role..." VerticalAlignment="Center" Padding="5"
                     TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Crew List -->
            <ListBox   Grid.Column="0" x:Name="CrewListBox" ItemsSource="{Binding FilteredCrew}" 
                     DisplayMemberPath="Name" SelectionChanged="CrewListBox_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <!-- Crew Details -->
            <Border Grid.Column="1" Background="#1a252f" BorderBrush="#FFC107" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Crew Details" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>
                    <TextBlock Text="Name:" Foreground="#FFC107" FontWeight="Bold"/>
                    <TextBlock   Text="Select a crew member" Foreground="White" FontSize="18" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Role:" Foreground="#FFC107" FontWeight="Bold"/>
                    <TextBlock   Text="-" Foreground="White" FontSize="18" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Status:" Foreground="#FFC107" FontWeight="Bold"/>
                    <TextBlock   Text="-" Foreground="White" FontSize="18" Margin="0,0,0,10"/>

                    <TextBlock Text="Assignments:" Foreground="#FFC107" FontWeight="Bold"/>
                    <TextBlock   Text="No assignments" Foreground="White" Margin="0,0,0,10"/>
                    
                    <Button Content="Assign to Mission" Margin="0,20,0,0" Padding="10,5" Background="#FFC107" Foreground="Black"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>