<UserControl x:Class="ScipDashboard.Modules.HaulingModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Hauling Module" FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>
            <TextBlock Text="Route planning and hauling status" FontSize="14" Foreground="#666" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="20" Background="White" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Active Route" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="No active route selected." FontStyle="Italic" Foreground="#999" TextWrapping="Wrap" MaxWidth="400"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
