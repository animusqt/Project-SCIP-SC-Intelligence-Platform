<UserControl x:Class="ScipDashboard.Modules.SettingsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>
            <TextBlock Text="Configure your dashboard preferences and data sources" FontSize="14" Foreground="#666" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="20" Background="White" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Theme" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ComboBox SelectedItem="{Binding Theme}" Width="200" Margin="0,0,0,20">
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="High Contrast"/>
                    </ComboBox>
                    
                    <TextBlock Text="Notifications" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox Content="Enable Desktop Notifications" IsChecked="{Binding ShowNotifications}" Margin="0,0,0,20"/>
                    
                    <Button Content="Save Settings" Padding="10" Background="#FFC107" Foreground="Black" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
