<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/twin"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             x:Class="ScipDashboard.Modules.DashboardSummary.DashboardSummaryModuleView"
              >
    <UserControl.Resources>
        <Style x:Key="QuickLookCard" TargetType="Border">
            <Setter Property="Background" Value="#2c3e50"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20">
            <TextBlock Text="Dashboard Overview" FontSize="24" FontWeight="Bold" Foreground="#FFC107"/>
        </StackPanel>

        <!-- Stats Grid -->
        <UniformGrid   Grid.Row="1" x:Name="StatsGrid" Columns="2" Margin="20">
            <Border Style="{StaticResource QuickLookCard}">
                <StackPanel>
                    <TextBlock Text="Active Hauls" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ActiveHaulCount}" Foreground="#FFC107" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource QuickLookCard}">
                <StackPanel>
                    <TextBlock Text="Active Routes" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ActiveRouteCount}" Foreground="#FFC107" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource QuickLookCard}">
                <StackPanel>
                    <TextBlock Text="Fleet Size" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding FleetCount}" Foreground="#FFC107" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource QuickLookCard}">
                <StackPanel>
                    <TextBlock Text="Cargo Capacity" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding CargoCapacity}" Foreground="#FFC107" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>